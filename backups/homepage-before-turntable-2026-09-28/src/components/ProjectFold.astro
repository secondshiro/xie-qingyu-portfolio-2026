---
interface Props {
  id: string;
  title: string;
  eyebrow: string;
  summary: string;
  href: string;
  tone?: 'stone' | 'paper';
}

const { id, title, eyebrow, summary, href, tone = 'paper' } = Astro.props;
---

<section class:list={['project-fold', `project-fold--${tone}`]} id={id}>
  <div class="site-container project-fold__inner">
    <p class="project-fold__eyebrow">{eyebrow}</p>
    <div class="project-fold__heading">
      <h2>{title}</h2>
      <p>{summary}</p>
    </div>
    <a class="project-fold__link" href={href}>
      查看完整案例 <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .project-fold {
    position: relative;
    background: var(--color-paper);
  }

  .project-fold--stone {
    background: var(--color-stone);
  }

  .project-fold__inner {
    display: grid;
    grid-template-columns: minmax(7rem, 0.45fr) minmax(0, 1.55fr);
    column-gap: clamp(2rem, 6vw, 7rem);
    row-gap: 1.5rem;
    align-items: start;
    padding-block: clamp(4.5rem, 6.5vw, 6rem);
  }

  .project-fold__eyebrow {
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .project-fold__heading {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }

  .project-fold__heading h2 {
    font-size: 2.25rem;
    line-height: 1.15;
  }

  .project-fold__heading p {
    max-width: 49rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.7vw, 1.35rem);
  }

  .project-fold__link {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-accent);
    font-size: 0.88rem;
    text-decoration: none;
  }

  @media (max-width: 42rem) {
    .project-fold__heading h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 52rem) {
    .project-fold__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .project-fold__link {
      grid-column: 1;
      width: max-content;
    }
  }
</style>

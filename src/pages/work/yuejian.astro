---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/yuejian/media';
const W = 780;
const H = 1688;

const facts = [
  { label: '角色', value: '信息架构、界面视觉与交互动效设计，独立完成' },
  { label: '输入', value: '广府非遗主题；展馆浏览、工坊预约与作品留存场景' },
  { label: '贡献', value: '四个底部栏目、八类页面布局、纸张动效与视觉规范' },
  { label: '输出', value: '十一屏可操作原型、五段演示录像、两页视觉规范' },
  { label: '阶段', value: '高保真原型完成；未上线，无业务数据' },
];

const tocSections = [
  { id: 'result', label: '00 / 先看结果' },
  { id: 'origin', label: '01 / 项目源头' },
  { id: 'play', label: '02 / 先玩一把' },
  { id: 'structure', label: '03 / 产品结构' },
  { id: 'language', label: '04 / 视觉语言' },
  { id: 'motion', label: '05 / 交互动效' },
  { id: 'boundary', label: '06 / 边界与下一步' },
];
---

<SiteLayout
  title="粤见 · 广府非遗体验小程序｜谢擎宇"
  description="围绕展馆浏览、工坊预约与手作留存设计的微信小程序概念原型，展示十一屏界面、纸张交互动效与视觉规范。"
  current="work"
>
  <main class="case-page" id="main" tabindex="-1">
    <CaseHero
      eyebrow="概念产品 · 移动端 C 端体验"
      title="粤见 · 广府非遗体验小程序"
      summary="粤见是一个广府非遗体验小程序的概念设计。我把展馆浏览、工坊预约和作品留存连在一起，让观众看过一件器物后，可以认识匠人、了解课程，再把体验中留下的作品收进自己的「手泽」册。设计重点是移动端的信息安排、纸墨视觉与交互动效。"
      facts={facts}
    />

    <div class="site-container case-cover">
      <MediaStage
        src={`${media}/screens/overview.png`}
        alt="粤见十一屏界面总览，按首页、展厅、器物、人物、工坊、课程、凭证和个人内容排列"
        caption="十一屏涵盖首页、展厅、工坊、我的，以及器物、人物、课程与作品详情。底部栏目只在四个主页面出现。界面照片为生成示意图，人物经历、引语与课程信息用于概念演示。"
        kind="proposal"
        label="界面总览"
        width={3424}
        height={4278}
        priority
      />
    </div>

    <CaseToc title="粤见 · 广府非遗体验小程序" sections={tocSections} />

    <CaseSection
      id="result"
      label="00 / 先看结果"
      title="十一屏走完「看、约、收」一条线"
      intro="先通过器物细节和匠人介绍了解一门手艺，再查看课程的时间、费用与余位，预约后留下入场凭证。体验中收下的作品汇集在「手泽」册里，可以回看与分享。下方原型可完整体验这条路径。"
      tone="stone"
    >
      <div class="evidence-key" data-columns="3" aria-label="三步体验导览">
        <div><b>看</b><p>从展品进入器物详情，再认识做它的人。</p></div>
        <div><b>约</b><p>先看清课程安排与费用，预约后保留入场凭证。</p></div>
        <div><b>收</b><p>把扫码小游戏与工坊课程的作品收在一处，回看时保留各自的来源。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="origin"
      label="01 / 项目源头"
      title="先定载体，再把一条体验线做深"
      intro="这次概念设计以展馆与工坊相连的场景为前提。范围收在一次体验之内，从看展品到了解课程，再到预约与留存作品，让内容浏览有一个可以继续参与的去向。"
    >
      <div class="case-blocks">
        <div class="case-copy">
          <p>观众在现场扫码后就能开始浏览，因此选择微信小程序作为载体。界面以手机竖屏为主，把图片、课程信息和底部操作放在单手浏览时容易找到的位置。</p>
        </div>

        <section class="case-block case-block--compare" aria-labelledby="origin-compare">
          <h3 id="origin-compare">同类参照与设计取舍</h3>
          <p>原型完成后，补充对照广东省非物质文化遗产馆的公开网页，重点看内容入口与活动信息的组织。</p>
          <div class="evidence-key" data-columns="2">
            <div><b>广东省非物质文化遗产馆</b><p>官网把展览、活动、非遗名录与数字资源分别组织，覆盖查资料、看展与参加活动等场馆服务。活动列表已提供地点、时间、报名时间和余票，工坊活动也有现场报名与小程序预约。</p></div>
            <div><b>粤见的体验范围</b><p>聚焦一次工坊体验。从器物进入，接着认识匠人、查看课程，再到预约凭证和作品册。四个主栏目围绕这条路径安排，示例课程按人预约，一次只约一场。</p></div>
          </div>
          <div class="case-callout">
            <p>综合场馆需要让不同目的的访客找到入口。粤见把一次体验做深，因此保留器物、人物和课程的连续去向，把预约与作品留存放在同一套页面里。</p>
          </div>
          <p><a href="https://www.gdsfyg.cn/" target="_blank" rel="noopener noreferrer">广东省非物质文化遗产馆官网 ↗</a></p>
        </section>

        <section class="case-block" aria-labelledby="origin-tradeoff">
          <h3 id="origin-tradeoff">落实到页面的三个选择</h3>
          <div class="workspace-notes">
            <div><b>从内容进入课程</b><p>器物详情先讲材质与工艺，末尾连接匠人，人物页再连接她的课。下一步入口紧贴正在看的内容。</p></div>
            <div><b>决定前看全信息</b><p>时间、地点与余位是双方都需交代的预约信息。粤见把三步工序和含材料费用也放在课程页，说明要做什么、要花多久。</p></div>
            <div><b>保留体验中的作品</b><p>扫码小游戏与课程手作收进「手泽」册，每件标明来源。作品详情保留图片和体验记录，并提供分享入口。</p></div>
          </div>
        </section>
      </div>
    </CaseSection>

    <CaseSection
      id="play"
      label="02 / 先玩一把"
      title="原型从第一针开始"
      intro="原型模拟观众在展馆扫码后的首次体验。先以粤绣小游戏引入，让观众拖针完成一朵小花，再把这份数字纪念收进「手泽」册。点「收下」进入作品册，点「先随便看看」进入首页，之后都可继续浏览与预约。旁边的录像展示完整过程。"
    >
      <div class="portrait-grid">
        <div class="proto-embed">
          <div class="proto-embed__viewport">
            <iframe src="/projects/yuejian/prototype/p0.html" title="粤见可操作原型（从上手第一针进入）" loading="lazy" data-yuejian-frame></iframe>
          </div>
          <a class="proto-embed__link" href="/projects/yuejian/prototype/p0.html" target="_blank" rel="noopener noreferrer">在新窗口打开原型 ↗</a>
        </div>
        <MediaStage src={`${media}/motion/p0-intro.mp4`} poster={`${media}/motion/p0-intro-poster.jpg`} alt="扫码小游戏全程录像，完成小花后收进我的手泽" caption="从拖针到收下，先完成一份数字纪念，再进入「我的手泽」。" kind="proposal" label="上手录像" video width={390} height={844} />
      </div>
      <script>
        const frame = document.querySelector<HTMLIFrameElement>('[data-yuejian-frame]');
        if (frame && matchMedia('(prefers-reduced-motion: reduce)').matches) {
          frame.src += (frame.src.includes('?') ? '&' : '?') + 'm=off';
        }
        /* iframe 内容一律按真机 390×844 布局，父页面按容器宽等比缩放——
           避免 340px 视口下 p0 按钮折行、v5 舞台溢出等响应式重排问题 */
        const vp = frame ? frame.closest('.proto-embed__viewport') : null;
        if (frame && vp) {
          const fit = () => {
            const s = vp.clientWidth / 390;
            frame.style.transform = 'scale(' + s + ')';
          };
          if ('ResizeObserver' in window) {
            new ResizeObserver(fit).observe(vp);
          }
          fit();
        }
      </script>
    </CaseSection>

    <CaseSection
      id="structure"
      label="03 / 产品结构"
      title="四个主栏目，详情按任务展开"
      intro="首页负责引入，展厅负责浏览，工坊承接预约，我的汇集凭证与作品。进入详情后收起底部栏目，把空间留给当前内容；返回时回到刚才的浏览位置。"
    >
      <div class="case-copy">
        <p>十一屏沿用八类基础布局。器物详情依次安排图片、材质与出处、工艺介绍和匠人入口；课程详情集中展示场次、费用与工序。我的课复用凭证卡，我的手泽复用作品卡，让同类内容在不同页面保持相同的阅读顺序。</p>
        <p>首页把器物图片作为主要入口，题名和材质放在画面下方，四枚圆点切换展品。整幅图片都可以点进详情，观众看中哪一件，就从哪一件继续了解。</p>
        <p>没有作品时，我的页面保留去工坊的入口，让空白处也能接住下一步。预约成功后，场次、地点与席位集中在凭证上，之后可以从我的课再次找到。</p>
      </div>
      <div class="portrait-grid">
        <MediaStage src={`${media}/screens/p1.png`} alt="首页，器物图片满幅展示，题名下有四枚展品切换圆点，底部为四个栏目" caption="首页。点图片进入器物详情，题名下的四枚圆点切换展品。" kind="proposal" width={W} height={H} />
        <MediaStage src={`${media}/screens/p2.png`} alt="展厅，七件展品横向排列，页头有全部与收藏切换" caption="展厅。七件展品横向陈列，页头可切换到收藏。" kind="proposal" width={W} height={H} />
        <MediaStage src={`${media}/screens/p5.png`} alt="工坊，主推课程卡片与其他场次列表" caption="工坊。主推课程用大图卡片，其他场次用列表展示时间与余位。" kind="proposal" width={W} height={H} />
      </div>
      <div class="portrait-grid">
        <MediaStage src={`${media}/screens/p8.png`} alt="我的，个人名片、作品卡与课程入口" caption="我的。先看到自己的作品，再找到课程、作品册与收藏入口。" kind="proposal" width={W} height={H} />
        <MediaStage src={`${media}/screens/p8-empty.png`} alt="我的页面空态，展示去工坊的入口" caption="还没有作品时，保留去工坊的入口。" kind="proposal" label="空态设计" width={W} height={H} />
        <MediaStage src={`${media}/screens/p9.png`} alt="我的课列表，待上课在前，已核销在后" caption="我的课。待上课的预约排在前面，已结束的课程保留在下方。" kind="proposal" label="延展页面" width={W} height={H} />
      </div>
      <div class="portrait-grid">
        <MediaStage src={`${media}/screens/p7.png`} alt="预约凭证，包含场次、地点、席位和入场码" caption="预约凭证。场次、地点、席位与入场码放在一张票上，方便到场时查找。" kind="proposal" width={W} height={H} />
        <MediaStage src={`${media}/screens/p10.png`} alt="我的手泽，扫码数字纪念与课程手作两张卡片" caption="我的手泽。扫码小游戏的数字纪念与课程手作一起留存，每件注明来源。" kind="proposal" label="延展页面" width={W} height={H} />
        <MediaStage src={`${media}/screens/p11.png`} alt="作品详情，广绣小花大图置顶，下方有扫码体验记录和分享入口" caption="作品详情。大图与体验记录放在一起，底部可以分享，也可以继续了解匠人。" kind="proposal" label="延展页面" width={W} height={H} />
      </div>
    </CaseSection>

    <CaseSection
      id="language"
      label="04 / 视觉语言"
      title="用纸白、墨黑、朱红与灰绿建立层次"
      intro="纸白承接图片与文字，墨黑保证正文清楚，朱红用于印章和操作提示，灰绿用于题名与人名。把色彩收在这四组里，让器物与人物照片保留画面的主要分量。"
    >
      <div class="portrait-grid">
        <MediaStage src={`${media}/screens/p3.png`} alt="器物详情，图片下方展示题名、材质、尺寸与出处，题名后跟印章" caption="器物详情。材质、尺寸与出处集中成组，正文分段展开，题名末尾保留一枚印章。" kind="proposal" width={W} height={H} />
        <MediaStage src={`${media}/screens/p4.png`} alt="人物档案，梁玉屏的照片、引语、经历与针法，下方连接课程" caption="人物档案。照片与引语引入匠人，经历和针法接在下方，底部承接她的课程。" kind="proposal" width={W} height={H} />
        <MediaStage src={`${media}/screens/p6.png`} alt="课程详情，场次与费用信息、三步工序和底部预约入口" caption="课程详情。先看场次、费用和余位，再看三步工序；预约入口固定在底部。" kind="proposal" width={W} height={H} />
      </div>
      <div class="case-copy">
        <p>器物与人物页面把图片、题名和正文拉开，让人可以慢慢看；课程页把时间、费用和余位靠拢，便于做决定。题名用明朝体，正文用宋体，导航与信息标签用黑体，以字体和间距区分阅读与操作。</p>
        <p>印章放在题名之后，作为落款；匠人入口用照片，便于识别人。预约按钮另有一处状态变化，支付前保留描边，确认后填实并显示已支付，让动作完成有一个明确的回应。</p>
      </div>
      <MediaStage src={`${media}/spec/ds-tokens.png`} alt="粤见设计规范第一页，色彩、字体层级与动效节奏" caption="视觉规范。统一色彩与字体层级，并记录各类动效的起落节奏。" kind="proposal" label="设计规范" width={2160} height={1730} />
      <MediaStage src={`${media}/spec/ds-pages.png`} alt="粤见设计规范第二页，八类页面布局与导航、印章、操作条示例" caption="页面与组件规范。说明内容顺序、导航位置、印章用法和预约按钮的状态。" kind="proposal" label="设计规范" width={2160} height={1774} />
    </CaseSection>

    <CaseSection
      id="motion"
      label="05 / 交互动效"
      title="让翻阅有纸感，让切换有来处"
      intro="动效沿用纸张的展开、翻阅与落定感。器物详情像展开一幅画，课程页像翻开课单，预约凭证像落下一张票。纸张能贯穿不同非遗题材，针线的动作则留在粤绣小游戏里。"
      tone="panel"
    >
      <div class="case-copy">
        <p>节奏上，图片先落稳，文字稍后跟上，避免所有内容同时涌出来。展开时起手稍慢，停下时收柔一点，让画面带一点纸张的重量。印章留在末尾轻压一下，作为这一页展开完成的收尾。</p>
      </div>
      <div class="portrait-grid portrait-grid--pair">
        <MediaStage src={`${media}/motion/p3-unroll.mp4`} poster={`${media}/motion/p3-unroll-poster.jpg`} alt="器物详情展开录像，纸边先落，图片与正文随后展开" caption="展开器物。纸边先落下，图片和正文随后展开，视线自然进入内容。" kind="proposal" label="动效录像" video width={390} height={844} />
        <MediaStage src={`${media}/motion/p6-flip.mp4`} poster={`${media}/motion/p6-flip-poster.jpg`} alt="课程详情翻页录像，课单翻开后展示三步工序" caption="翻开课单。先看到纸面翻开，再读到三步工序。" kind="proposal" label="动效录像" video width={390} height={844} />
        <MediaStage src={`${media}/motion/p7-tear.mp4`} poster={`${media}/motion/p7-tear-poster.jpg`} alt="凭证动效录像，票卡落下、骑缝断开后盖印" caption="收下凭证。票卡落下、骑缝断开，最后盖印，回应预约完成。" kind="proposal" label="动效录像" video width={390} height={844} />
        <MediaStage src={`${media}/motion/p56-handoff.mp4`} poster={`${media}/motion/p56-handoff-poster.jpg`} alt="从工坊进入课程详情的录像，同一张图片放大成为题图，文字在新位置出现" caption="从工坊进入课程。同一张图片放大成为详情题图，让人看清刚才点开的课程；文字在新位置出现。" kind="proposal" label="动效录像" video width={390} height={844} />
      </div>
    </CaseSection>

    <CaseSection
      id="boundary"
      label="06 / 边界与下一步"
      title="这一版的交付与后续完善"
      intro="当前完成的是概念产品的高保真原型，尚未上线，无业务数据。"
    >
      <div class="value-grid">
        <article class="value-card"><span>已交付</span><h3>十一屏界面与扫码小游戏</h3><p>从扫码小游戏进入浏览与预约，配有五段演示录像和两页视觉规范。</p></article>
        <article class="value-card"><span>可继续</span><h3>同类内容保持一致</h3><p>课程、凭证与作品卡沿用各自的内容顺序，后续增加内容时继续使用。</p></article>
        <article class="value-card"><span>下一步</span><h3>带入真实工坊场景</h3><p>下一步结合工坊的实际排期、预约与入场规则，确认课程信息和凭证是否够用。</p></article>
      </div>
      <div class="case-copy">
        <p>界面照片为生成示意图，人物经历、引语与课程安排均用于概念演示。正式使用前，需要以真实展品、匠人与工坊资料替换，并完成相应授权。当前原型演示预约流程，未接入真实支付。</p>
      </div>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">继续看看其他作品</h2>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
      </div>
    </section>
  </main>
</SiteLayout>

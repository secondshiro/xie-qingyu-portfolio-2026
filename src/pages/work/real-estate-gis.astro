---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import PrototypeFrame from '../../components/PrototypeFrame.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/real-estate-gis/media';
const prototypes = '/projects/real-estate-gis/prototypes';
const mapPrototype = `${prototypes}/map/index.html?restore=1&building=宇济一号&code=17幢`;
const facts = [
  { label: '角色', value: '业务梳理、产品架构、UX 与交互原型' },
  { label: '输入', value: '需求规格、业务流程与旧系统截图' },
  { label: '贡献', value: '业务入口分配、整幢布局与户室关系核对' },
  { label: '输出', value: '总图、整幢和实测替换预测三个可操作原型' },
  { label: '边界', value: '个人回溯重构 · 已完成交互原型' },
];
---

<SiteLayout
  title="房产 GIS 体验重构｜谢擎宇"
  description="房产系统信创迁移中的体验重构，围绕总图定位楼栋、查看整幢房屋与核对测绘变更，提供三个可操作原型。"
  current="work"
>
  <main class="case-page gis-case" id="main" tabindex="-1">
    <CaseHero
      title="房产 GIS 体验重构"
      facts={facts}
    >
      <Fragment slot="summary">房产系统迁移到国产技术环境时，工作人员仍要<strong>在地图上找楼、查看整幢房屋、核对测绘变更</strong>。我沿着这三件事重排了页面与入口，完成三套可操作的个人回溯原型。</Fragment>
    </CaseHero>

    <CaseToc />

    <CaseSection
      id="result"
      label="00 / 先看结果"
      title="从 17 幢查看房屋或核对变更"
      tone="stone"
    >
      <Fragment slot="intro">总图默认展示宇济一号 17 幢。右侧面板显示入库状态、测绘摘要与两个入口，可以去<strong>分层分户图</strong>看整幢户室，也可以去<strong>实测替换预测</strong>核对测绘差异。原型使用演示数据。幢指一栋楼，户室指楼内按房号管理的房屋。</Fragment>
      <PrototypeFrame
        src={mapPrototype}
        title="房产 GIS 总图交互原型"
        poster={`${media}/final/map-current-overview.png`}
        posterAlt="总图选中宇济一号 17 幢。左侧展开图层，右侧从上到下显示测绘摘要、两项操作入口和楼幢资料"
        linkLabel="打开完整总图原型"
      />
      <div class="opportunity-path" aria-label="17 幢演示路径">
        <span>总图定位到 17 幢</span><i aria-hidden="true">→</i>
        <span>查看整幢房屋，或核对测绘变更</span>
      </div>
      <div class="case-copy">
        <p><strong>三个原型使用同一组演示对象。</strong>总图和整幢页都查看 17 幢，测绘核对以这栋楼的 1501 室演示新旧记录的比对。</p>
      </div>
    </CaseSection>

    <CaseSection
      id="origin"
      label="01 / 项目源头"
      title="技术迁移是背景，我重排的是任务路径"
      intro="我用需求规格、业务流程、旧系统截图和初版原型，梳理三个任务各自需要的对象、信息与操作。"
    >
      <div class="case-copy">
        <ul class="case-points">
          <li><strong>总图</strong>以楼幢为主，负责地图定位、入库状态确认与任务入口。</li>
          <li><strong>整幢页</strong>以户室为主，按楼层和单元对照房屋状态与属性。</li>
          <li><strong>核对页</strong>以户室对应关系为主，比对测绘记录与系统记录是否匹配、面积相差多少。</li>
        </ul>
        <p>各页面把其他信息放到需要时再查看的位置。</p>
      </div>
    </CaseSection>

    <CaseSection
      id="problem"
      label="02 / 问题重定义"
      title="同一批房屋信息，三个任务看的东西不同"
      tone="panel"
    >
      <Fragment slot="intro">对照旧界面的布局，我分别检查<strong>定位、逐户对照与测绘核对</strong>时，工作人员需要同时看到哪些信息。</Fragment>
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-map-observed.webp`}
          alt="旧系统总图，顶部排列地图工具，左侧为图层列表，中间显示楼栋地图"
          caption="总图以顶部工具栏组织操作，左侧管理图层，中间展示楼栋地图。"
          kind="observed"
          width={1600}
          height={1000}
        />
        <MediaStage
          src={`${media}/public/legacy-building-observed.webp`}
          alt="旧系统分层分户图，上方为平面区，左侧显示房屋属性，下方为彩色楼盘表"
          caption="分层分户图同时展示平面区、属性和楼盘表，户室矩阵位于下半屏。"
          kind="observed"
          width={1600}
          height={1000}
        />
      </div>
      <div class="case-copy">
        <ul class="case-points">
          <li><strong>旧总图</strong>把工具放在顶部，楼幢属性在另一处。确认当前楼幢和选择下一步操作发生在同一步，我把属性与相关入口放进同一面板。</li>
          <li><strong>旧整幢页</strong>同时展示工具、属性和平面图，供逐户对照的楼盘表位于下半屏。重排时，我把主要区域留给户室矩阵。</li>
          <li><strong>旧核对界面</strong>将两张记录表逐行并排。判断一组户室是否对应时，需要同时看两边的房号与面积，我把两侧记录和面积差放进同一张关系卡。</li>
        </ul>
      </div>
    </CaseSection>

    <CaseSection
      id="workspaces"
      label="03 / 核心方案"
      title="找到楼以后，按任务查看房屋和核对变更"
      intro="三个页面围绕同一栋楼分工。定位后，可按需要查看整幢或核对变更。"
      tone="stone"
    >
      <div class="workspace-stack">
        <article class="workspace">
          <header class="workspace__header">
            <span>空间 · 选幢</span>
            <div><h3>定位楼幢后，先确认对象再选任务</h3><p><strong>总图右侧面板</strong>先显示楼幢名、入库状态和测绘摘要，下方紧接查看户室与核对测绘两个入口。坐落等常用资料直接展示，历史与维护记录按需展开。</p><p>日常操作仍先确定楼幢，再选任务。<strong>需要新建或入库的楼幢可能还没有地图图形</strong>，因此相关功能留在地图上方的「业务入口」。</p></div>
          </header>
          <div class="experience-diagram" aria-label="从搜索定位到查看楼幢信息的操作路径">
            <div class="diagram-node diagram-node--map"><span class="diagram-kicker">空间</span><b>地图定位</b><div class="map-sketch" aria-hidden="true"><i></i><i></i><i></i><i></i><b>17</b><span></span><span></span></div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--building"><span class="diagram-kicker">对象</span><b>定位到 17 幢</b><div class="building-shape">17</div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--panel"><span class="diagram-kicker">继续工作</span><b>楼幢面板</b><div class="panel-sketch" aria-hidden="true"><strong>宇济一号 · 17幢</strong><i></i><i></i><i></i><i></i></div></div>
          </div>
          <div class="workspace-notes"><div><b>图层与对象</b><p>图层设置在左侧，右侧属性面板随搜索定位的楼幢更新。</p></div><div><b>搜索定位</b><p>支持顶栏搜索楼盘名或幢号直接定位。</p></div><div><b>展开维护</b><p>展开「历史与维护」后，左侧查记录，右侧找维护入口。</p></div></div>
          <a class="workspace__prototype-link" href={mapPrototype} target="_blank" rel="noopener noreferrer">打开 17 幢的总图原型 ↗</a>
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>对象 · 看整幢</span>
            <div><h3>把主要区域留给整幢户室</h3><p><strong>整幢页把主要区域留给矩阵</strong>，实际层与业务使用的名义层分列对照。房号用深色显示，业务状态用格底短色条表示。点选户室后可在侧栏查看属性及平面参考。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/public/legacy-building-overview-observed.webp`} alt="旧整幢页面同时保留顶部工具、左侧属性、上方平面区和下方楼盘表" caption="改版前，上方平面区、左侧属性和下方楼盘表同时保留，整幢户室集中在下半屏。" kind="observed" width={1600} height={1000} />
            <MediaStage src={`${media}/final/building-current-overview.png`} alt="宇济一号 17 幢的分层分户图，左侧为平面参考和属性，右侧为浅底户室矩阵" caption="改版后，平面参考收进左侧，右侧矩阵可并排查看同一层的多个单元。" kind="redesigned" width={1440} height={900} />
          </div>
          <PrototypeFrame src={`${prototypes}/building/index.html?building=宇济一号&code=17幢&room=1501`} title="分层分户图交互原型" poster={`${media}/final/building-current-overview.png`} posterAlt="宇济一号 17 幢的分层分户图，矩阵中用浅蓝底和蓝色描边标出 1 单元 1501 室" linkLabel="打开完整整幢房屋原型" />
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>任务 · 核对变更</span>
            <div><h3>把户室对应和面积差异放在同一行</h3><p><strong>实测替换预测是测绘成果回到系统前的核对环节</strong>。我把系统记录与测绘记录放在关系卡两侧，面积差放在中间。以 1501 室为例，系统记录 94.20㎡，测绘记录 95.90㎡，<strong>卡片标出 +1.70㎡</strong>。</p><p>顶部任务栏显示当前楼幢与三步进度。进入入库模式后，可按状态筛出待核对项并逐组确认。拆分、合并等结构变化要单独处置，未处理时会拦截提交。</p></div>
          </header>
          <div class="experience-diagram experience-diagram--task" aria-label="从对照户室和面积到人工确认的核对路径">
            <div class="diagram-node diagram-node--relation"><span class="diagram-kicker">核对内容</span><b>同一间房的两份记录</b><div class="room-pair" aria-hidden="true"><span><b>系统记录</b>1501室<br /><small>94.20㎡</small></span><em>?</em><span><b>测绘记录</b>1501室<br /><small>95.90㎡</small></span></div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--cards"><span class="diagram-kicker">判断依据</span><b>关系卡</b><div class="relation-card" aria-hidden="true"><span>面积差异</span><strong>+1.70㎡</strong><small>需人工核对</small></div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--decision"><span class="diagram-kicker">人工确认</span><b>核对状态</b><div class="decision-state" aria-hidden="true"><span></span>待核对</div><small>展示确认反馈，不实际入库</small></div>
          </div>
          <PrototypeFrame src={`${prototypes}/task/index.html?building=宇济一号&code=17幢&from=gis&step=3&view=cards&filter=review`} title="实测替换预测交互原型" poster={`${media}/final/13-task-relations-focus.png`} posterAlt="宇济一号 17 幢的实测替换预测页面，第三步选中待核对，结果以关系卡显示" linkLabel="打开完整测绘变更核对原型" />
        </article>
      </div>
    </CaseSection>

    <CaseSection
      id="strategy"
      label="04 / 行业判断"
      title="用三类产品，检查入口、地图与核对怎么组织"
      intro="展开下方参照，查看我怎样检查业务入口的位置、地图的职责和逐项核对的粒度。"
    >
      <details class="industry-references">
        <summary>查看参照依据<span aria-hidden="true">＋</span></summary>
        <div class="industry-references__content">
          <div class="reference-grid">
            <article class="reference-card">
              <span>直接行业平台</span>
              <h3>选中楼栋后，业务入口放在哪</h3>
              <p>我用 SuperMap 的不动产登记方案做业务参照，检查楼幢与操作的关系。本案把<strong>与当前楼幢相关的入口</strong>放在右侧对象面板里。</p>
              <a href="https://www.supermap.com/zh-cn/a/solutions/119_4553.html" target="_blank" rel="noopener noreferrer">SuperMap 公开资料 ↗</a>
            </article>
            <article class="reference-card">
              <span>空间产品参照</span>
              <h3>地图在整个页面里承担什么</h3>
              <p>我用 DataV Atlas 作为地理空间数据的呈现参照。在本案里，<strong>地图负责呈现楼幢位置</strong>，属性和操作放在侧边面板。</p>
              <a href="https://help.aliyun.com/zh/datav/datav-atlas/product-overview/what-is-datav-atlas/" target="_blank" rel="noopener noreferrer">DataV Atlas 公开资料 ↗</a>
            </article>
            <article class="reference-card">
              <span>工作流产品参照</span>
              <h3>逐项核对要拆到什么粒度</h3>
              <p>飞书多维表格按记录组织状态。本案<strong>按一组户室对应安排一张关系卡</strong>，由工作人员核对并确认。</p>
              <a href="https://www.feishu.cn/product/base" target="_blank" rel="noopener noreferrer">飞书多维表格公开资料 ↗</a>
            </article>
          </div>
          <div class="opportunity-path" aria-label="从定位楼栋到核对变更的设计思路">
            <span>在总图定位楼幢</span><i aria-hidden="true">→</i>
            <span>保留当前楼栋信息</span><i aria-hidden="true">→</i>
            <span>继续核对业务关系</span>
          </div>
        </div>
      </details>
    </CaseSection>

    <CaseSection
      id="tradeoffs"
      label="05 / 设计取舍"
      title="让信息更集中，也保留业务判断的依据"
      intro="重排时保留三类业务判断所需的信息，分别是户室状态和选中状态、楼层号与平面参考、单组关系与多组字段。"
    >
      <div class="decision-grid">
        <article class="decision-card"><span>01</span><h3>业务状态和当前选中分别表达</h3><p>原图例的 <strong>20 项状态和房屋性质符号</strong>继续保留。同一户的状态色用格底短条并排显示，房号保持清晰。选中用浅蓝底和蓝色描边区分，点选户室后保留组合筛选。</p></article>
        <article class="decision-card"><span>02</span><h3>矩阵看整幢，平面图作参考</h3><p>矩阵用来对照整层户室，平面图收进侧栏，供确认某户的位置。<strong>实际第 18 层对应名义 17A 层</strong>，两列并排可同时核对实际层序和业务用名。</p></article>
        <article class="decision-card"><span>03</span><h3>关系卡看对应，表格查字段</h3><p>关系卡看单组对应与面积差，表格按列对照多组记录的层号、房号或面积。<strong>切换视图时保留当前状态筛选</strong>。</p></article>
      </div>
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/15-decision-matrix.png`} alt="户室矩阵局部，左侧并列显示实际层和名义层，格内房号下方是短色条" caption="同一户有多项业务状态时，几段颜色在房号下方并排。" kind="redesigned" width={1190} height={380} />
        <MediaStage src={`${media}/final/16-decision-relation-card.png`} alt="关系卡局部，系统记录与测绘记录两侧排列，面积差异显示在中间" caption="系统记录与测绘记录并列，面积差异显示在中间，卡片同时标记待核对状态。" kind="redesigned" width={1196} height={144} />
      </div>
    </CaseSection>

    <CaseSection
      id="impact"
      label="06 / 价值与边界"
      title="让设计判断可以在具体操作中检验"
      intro="用 17 幢和 1501 室检查三个原型的对象对应，再用面积差、未关联户室与结构变化样例检查核对反馈。"
      tone="panel"
    >
      <div class="value-grid">
        <article class="value-card"><span>对象对应</span><h3>从楼栋进入对应的房屋信息</h3><p>从默认展示的 17 幢打开整幢页，选择 1501 室，再返回总图核对楼幢是否一致。</p></article>
        <article class="value-card"><span>信息主次</span><h3>改版前后的画面可以直接对照</h3><p>并排看平面参考、属性和矩阵各占多少区域，再打开原型点选一户，检查侧栏怎样跟随。</p></article>
        <article class="value-card"><span>异常反馈</span><h3>核对关系时区分普通差异和结构变化</h3><p>面积差异、未关联户室与结构变化分别标出，尚未处置的结构变化会被拦截提交。</p></article>
      </div>
      <div class="case-copy">
        <ul class="case-points">
          <li><strong>个人回溯原型</strong>使用固定演示数据，新建与资料入库只保留入口，未对接业务系统。</li>
          <li><strong>仍需业务确认</strong>的事项包括面积差异阈值、关联建议和结构变化的处置流程。</li>
        </ul>
      </div>
    </CaseSection>

    <CaseSection
      id="ai-collaboration"
      label="07 / AI 协作"
      title="AI 协助整理和实现，业务判断由我负责"
    >
      <Fragment slot="intro">我确定<strong>页面结构、操作规则和状态含义</strong>，AI 协助读取材料、生成页面并检查一致性。每轮产出都对照原始需求，核对操作、状态和字段后再纳入原型。</Fragment>
      <div class="boundary-grid">
        <article class="boundary-card"><h3>用 AI 把方案做成可操作页面</h3><p>打开三个独立页面，围绕同一栋楼检查布局和对象对应，发现问题后回到操作规则或页面修正。</p></article>
        <article class="boundary-card"><h3>用业务事实约束生成结果</h3><p>例如，演示关系卡把面积差标给人工核对。差多少必须拦截仍需业务确认，不能由生成结果替代判断。</p></article>
      </div>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">继续看看其他作品</h2>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .industry-references > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 0.75rem;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  .industry-references > summary::-webkit-details-marker {
    display: none;
  }

  .industry-references > summary span {
    flex: none;
    font-size: 1.25rem;
  }

  .industry-references[open] > summary span {
    transform: rotate(45deg);
  }

  .industry-references__content {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
  }
</style>

<script>
  const references = document.querySelector<HTMLDetailsElement>('.industry-references');
  const revealReferences = () => {
    if (references && location.hash === '#strategy') references.open = true;
  };

  revealReferences();
  window.addEventListener('hashchange', revealReferences);
  // A repeated click on the current hash does not emit hashchange.
  document.querySelector('a[href="#strategy"]')?.addEventListener('click', () => {
    if (references) references.open = true;
  });
</script>

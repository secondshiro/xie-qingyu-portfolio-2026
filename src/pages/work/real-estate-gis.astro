---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import PrototypeFrame from '../../components/PrototypeFrame.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/real-estate-gis/media';
const prototypes = '/projects/real-estate-gis/prototypes';
const mapPrototype = `${prototypes}/map/index.html?restore=1&building=宇济一号&code=17幢`;
const buildingPrototype = `${prototypes}/building/index.html?building=宇济一号&code=17幢&room=1501`;
const taskPrototype = `${prototypes}/task/index.html?building=宇济一号&code=17幢&from=gis&step=3&view=cards&filter=review`;

const facts = [
  { label: '角色', value: '业务梳理、信息架构、UX 与交互原型' },
  { label: '输入', value: '需求规格、业务流程与旧系统截图' },
  { label: '输出', value: '总图、整幢与实测替换预测三个可操作原型' },
  { label: '演示对象', value: '宇济一号 17 幢 · 静态演示数据' },
  { label: '边界', value: '个人回溯重构 · 未对接生产库' },
];

const tocSections = [
  { id: 'building', label: '00 / 整幢怎么看' },
  { id: 'map', label: '01 / 入口怎么分' },
  { id: 'reconcile', label: '02 / 异常怎么拦' },
  { id: 'strategy', label: '03 / 行业参照' },
  { id: 'boundary', label: '04 / 验证与边界' },
];
---

<SiteLayout
  title="房产 GIS 体验重构｜谢擎宇"
  description="房产系统信创迁移中的个人回溯重构，围绕整幢矩阵、总图入口分工与测绘变更拦截，提供三个可操作原型。"
  current="work"
>
  <main class="case-page gis-case" id="main" tabindex="-1">
    <CaseHero
      title="房产 GIS 体验重构"
      facts={facts}
    >
      <Fragment slot="summary">房产系统迁移到国产技术环境时，工作人员仍要在地图上找楼、查看整幢房屋、核对测绘变更。我用三个个人回溯原型演示如何<strong>扩大整幢矩阵的查看区域、按楼幢分配操作入口，以及在提交前拦截待核对的测绘变更</strong>。</Fragment>
    </CaseHero>

    <CaseToc title="房产 GIS 体验重构" sections={tocSections} />

    <span id="origin" class="gis-previous-anchor" aria-hidden="true"></span>
    <span id="workspaces" class="gis-previous-anchor" aria-hidden="true"></span>
    <span id="tradeoffs" class="gis-previous-anchor" aria-hidden="true"></span>
    <CaseSection
      id="building"
      label="00 / 整幢怎么看"
      title="把主要区域留给户室矩阵，用格底色条标记状态"
      tone="stone"
    >
      <Fragment slot="intro">整幢页的楼盘表按楼层、单元排列户室，工作人员可以逐户核对。旧界面把工具和大块平面区放在上方，楼盘表集中在下方，并以整格底色标记业务状态。同一户有多种状态时，需要同时辨认房号、状态和当前选中位置。</Fragment>

      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-building-overview-observed.webp`}
          alt="旧系统分层分户图，上方为平面区，左侧显示房屋属性，下方为彩色楼盘表"
          caption="旧版上方保留平面区和工具，下方楼盘表以单元格底色标记业务状态。"
          kind="observed"
          width={800}
          height={450}
        />
        <MediaStage
          src={`${media}/final/building-current-overview.png`}
          alt="宇济一号 17 幢的分层分户图，左侧为平面参考和属性，右侧为浅底户室矩阵，选中 1 单元 1501 室"
          caption="重构后右侧集中展示矩阵。实际第 18 层和业务使用的名义 17A 层可以并列对照。"
          kind="redesigned"
          width={1440}
          height={900}
        />
      </div>

      <div class="tradeoff-note">
        <div class="tradeoff-note__meta">
          <span class="tradeoff-note__tag">设计取舍</span>
          <h3>平面参考与户室矩阵同屏</h3>
        </div>
        <p>逐户核对时，楼盘表用于比较整层房号，平面图用于定位某一户。我把平面图和属性移到左栏，让两类信息保持联动。我同时保留<strong>原图例的 20 项业务状态</strong>和房屋性质符号，便于核对同一户的多项记录。</p>
      </div>

      <div class="case-copy">
        <p>状态色在房号下方以 5px 高的短条并排显示，浅蓝底和蓝色描边标记当前选中的户室。点选 1 单元 1501 室时，左侧属性和平面参考同步更新，矩阵保留当前筛选。</p>
      </div>

      <div class="gis-detail">
        <MediaStage
          src={`${media}/final/15-decision-matrix.png`}
          alt="户室矩阵局部，左侧并列显示实际层和名义层，格内房号下方是短色条"
          caption="实际第 19 至 27 层的矩阵局部。多项业务状态在同一房号下方并排显示。"
          kind="redesigned"
          width={1190}
          height={380}
        />
      </div>

      <PrototypeFrame
        src={buildingPrototype}
        title="分层分户图交互原型"
        poster={`${media}/final/building-current-overview.png`}
        posterAlt="宇济一号 17 幢的分层分户图，矩阵中用浅蓝底和蓝色描边标出 1 单元 1501 室"
        linkLabel="打开完整整幢房屋原型"
      />
    </CaseSection>

    <span id="result" class="gis-previous-anchor" aria-hidden="true"></span>
    <span id="problem" class="gis-previous-anchor" aria-hidden="true"></span>
    <CaseSection
      id="map"
      label="01 / 入口怎么分"
      title="楼幢操作放在对象面板，无图幢业务留在顶部"
    >
      <Fragment slot="intro">旧总图在顶部集中放置工具。定位到一栋楼后，工作人员需要先核对幢号和测绘信息，再决定查看整幢房屋还是核对测绘差异。</Fragment>

      <div class="tradeoff-note">
        <div class="tradeoff-note__meta">
          <span class="tradeoff-note__tag">设计取舍</span>
          <h3>按是否依赖选幢分配入口</h3>
        </div>
        <p>查看户室和核对测绘前，经办人需要先确认办理对象。我把这两个入口和楼幢资料放在一起。尚未在地图上标绘的楼幢称为<strong>无图幢</strong>，手工建楼盘和新楼盘入库从地图上方的「业务入口」开始。</p>
      </div>

      <div class="case-copy">
        <p>右侧楼幢面板显示入库状态、测绘摘要和两个操作入口，分别通往<strong>分层分户图</strong>和<strong>实测替换预测</strong>。坐落、幢号等定位字段默认可见，历史记录和维护操作收进「历史与维护」。</p>
      </div>

      <div class="experience-diagram" aria-label="从搜索定位到查看楼幢信息的操作路径">
        <div class="diagram-node diagram-node--map"><span class="diagram-kicker">先找楼</span><b>搜索楼盘或幢号</b><div class="map-sketch" aria-hidden="true"><i></i><i></i><i></i><i></i><b>17</b><span></span><span></span></div></div>
        <span class="diagram-arrow" aria-hidden="true">→</span>
        <div class="diagram-node diagram-node--building"><span class="diagram-kicker">定对象</span><b>锁定 17 幢</b><div class="building-shape">17</div></div>
        <span class="diagram-arrow" aria-hidden="true">→</span>
        <div class="diagram-node diagram-node--panel"><span class="diagram-kicker">接任务</span><b>从右侧面板进入</b><div class="panel-sketch" aria-hidden="true"><strong>宇济一号 · 17幢</strong><i></i><i></i><i></i><i></i></div></div>
      </div>

      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-map-observed.webp`}
          alt="旧系统总图，顶部排列地图工具，左侧为图层列表，中间显示楼幢地图"
          caption="旧总图在地图上方排列工具图标。"
          kind="observed"
          width={800}
          height={424}
        />
        <MediaStage
          src={`${media}/final/map-current-overview.png`}
          alt="总图选中宇济一号 17 幢。左侧展开图层，右侧从上到下显示测绘摘要、两项操作入口和楼幢资料"
          caption="重构后左侧管理图层，右侧集中展示当前楼幢摘要和任务入口。底图用于演示定位。"
          kind="redesigned"
          width={1440}
          height={900}
        />
      </div>

      <PrototypeFrame
        src={mapPrototype}
        title="房产 GIS 总图交互原型"
        poster={`${media}/final/map-current-overview.png`}
        posterAlt="总图选中宇济一号 17 幢。左侧展开图层，右侧从上到下显示测绘摘要、两项操作入口和楼幢资料"
        linkLabel="打开完整总图原型"
      />
    </CaseSection>

    <CaseSection
      id="reconcile"
      label="02 / 异常怎么拦"
      title="标出面积差，拦截待处置的结构变化"
      tone="stone"
    >
      <Fragment slot="intro">实测替换预测是测绘成果入库前的核对环节。旧界面并排展示两张记录表，核对一户需要同时比对两边的房号和面积。我把同一组户室的两侧记录和面积差放进一张关系卡，并为拆分、合并等结构变化设置单独的处置入口。</Fragment>

      <div class="experience-diagram experience-diagram--task" aria-label="从对照户室和面积到人工确认的核对路径">
        <div class="diagram-node diagram-node--relation"><span class="diagram-kicker">普通面积差</span><b>1501 室两份记录</b><div class="room-pair" aria-hidden="true"><span><b>系统记录</b>1501室<br /><small>94.20㎡</small></span><em>?</em><span><b>测绘记录</b>1501室<br /><small>95.90㎡</small></span></div></div>
        <span class="diagram-arrow" aria-hidden="true">→</span>
        <div class="diagram-node diagram-node--cards"><span class="diagram-kicker">系统标差值</span><b>关系卡提示</b><div class="relation-card" aria-hidden="true"><span>面积差异</span><strong>+1.70㎡</strong><small>交由经办人确认</small></div></div>
        <span class="diagram-arrow" aria-hidden="true">→</span>
        <div class="diagram-node diagram-node--decision"><span class="diagram-kicker">确认结果</span><b>经办人核对</b><div class="decision-state" aria-hidden="true"><span></span>待核对</div><small>核对两份记录后确认</small></div>
      </div>

      <div class="tradeoff-note">
        <div class="tradeoff-note__meta">
          <span class="tradeoff-note__tag">设计取舍</span>
          <h3>人工核对面积和户室关系</h3>
        </div>
        <p>面积差值供经办人对照记录，具体阈值需由业务方确认。拆分、合并会改变户室对应关系，需要单独处置。关系卡用于逐组核对差值，表格用于按列对照多组房号和楼层。</p>
      </div>

      <div class="case-copy">
        <ul class="case-points">
          <li><strong>面积差提示。</strong>以 1 单元 1501 室为例，系统记录 94.20㎡，测绘记录 95.90㎡。卡片标出 <strong>+1.70㎡</strong>，供经办人核对。</li>
          <li><strong>结构变化拦截。</strong>拆分、合并会改变楼盘表的户室对应关系。原型在顶部提示待处置数量，可将相关记录转人工核对或转入楼盘变更。<strong>转办待处理时仍无法提交。</strong></li>
          <li><strong>关系卡与表格。</strong>切换视图时保留当前状态筛选。</li>
        </ul>
      </div>

      <div class="gis-detail">
        <MediaStage
          src={`${media}/final/16-decision-relation-card.png`}
          alt="关联多合一卡片，左侧列出两户现有记录，右侧是一户测绘记录"
          caption="2 单元 2502、2503 室对应一条测绘记录。卡片标记「疑似多合一」，并提示结合楼盘变更业务核对。"
          kind="redesigned"
          width={1200}
          height={270}
        />
      </div>

      <PrototypeFrame
        src={taskPrototype}
        title="实测替换预测交互原型"
        poster={`${media}/final/13-task-relations-focus.png`}
        posterAlt="宇济一号 17 幢的实测替换预测页面，顶部黄色提示条拦截 6 项结构变化，下方以关系卡显示待核对记录"
        linkLabel="打开完整测绘变更核对原型"
      />
    </CaseSection>

    <CaseSection
      id="strategy"
      label="03 / 行业参照"
      title="用三类产品，校验入口、地图与核对粒度"
      intro="用公开产品资料对照三个问题，分别是楼幢操作放在哪里、地图承担什么任务、户室按什么粒度核对。"
      tone="panel"
    >
      <details class="industry-references">
        <summary>查看参照依据<span aria-hidden="true">＋</span></summary>
        <div class="industry-references__content">
          <div class="reference-grid">
            <article class="reference-card">
              <span>直接行业平台</span>
              <h3>选中楼幢后，业务入口放在哪里</h3>
              <p>对照 SuperMap 的不动产登记方案，检查楼幢与操作的关系。本案把<strong>与当前楼幢绑定的入口</strong>收进右侧对象面板。</p>
              <a href="https://www.supermap.com/zh-cn/a/solutions/119_4553.html" target="_blank" rel="noopener noreferrer">SuperMap 公开资料 ↗</a>
            </article>
            <article class="reference-card">
              <span>空间产品参照</span>
              <h3>地图承担什么任务</h3>
              <p>参照 DataV Atlas 的空间表达方式，让<strong>地图专注呈现位置与选区</strong>，属性和操作退到侧边面板。</p>
              <a href="https://help.aliyun.com/zh/datav/datav-atlas/product-overview/what-is-datav-atlas/" target="_blank" rel="noopener noreferrer">DataV Atlas 公开资料 ↗</a>
            </article>
            <article class="reference-card">
              <span>工作流产品参照</span>
              <h3>户室按什么粒度核对</h3>
              <p>参照飞书多维表格按记录组织状态的做法，<strong>按一组户室对应安排一张关系卡</strong>，逐组确认或转办。</p>
              <a href="https://www.feishu.cn/product/base" target="_blank" rel="noopener noreferrer">飞书多维表格公开资料 ↗</a>
            </article>
          </div>
        </div>
      </details>
    </CaseSection>

    <span id="impact" class="gis-previous-anchor" aria-hidden="true"></span>
    <span id="ai-collaboration" class="gis-previous-anchor" aria-hidden="true"></span>
    <CaseSection
      id="boundary"
      label="04 / 验证与边界"
      title="原型可验证的操作与待确认的业务规则"
    >
      <Fragment slot="intro">三个原型共用同一楼幢的演示数据。我根据需求规格和旧界面确定矩阵布局、入口和异常反馈，AI 协助整理材料、实现页面和检查一致性。</Fragment>

      <div class="boundary-grid">
        <article class="boundary-card">
          <h3>可以在原型中操作</h3>
          <ul>
            <li>从总图的 17 幢打开分层分户图，可对照实际第 18 层和名义 17A 层。点选 1 单元 1501 室，可检查侧栏是否显示该户。</li>
            <li>从总图进入同一幢楼的实测替换预测。在第 3 步转办一项结构变化，可检查待处理状态和仍被禁用的提交按钮。刷新页面后恢复演示初始状态。</li>
          </ul>
        </article>
        <article class="boundary-card">
          <h3>落地前仍需确认</h3>
          <ul>
            <li>新建楼盘和楼盘入库在总图中展示入口。现有原型使用演示数据，未接入审批流程和生产库。</li>
            <li>面积差异阈值、户室关联规则与拆分合并的办理方式，需要结合当地业务口径确认。</li>
          </ul>
        </article>
      </div>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">继续看看其他作品</h2>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .gis-previous-anchor {
    display: block;
    scroll-margin-top: 3rem;
  }

  .industry-references > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 0.75rem;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }

  .industry-references > summary::-webkit-details-marker {
    display: none;
  }

  .industry-references > summary span {
    flex: none;
    font-size: 1.25rem;
  }

  .industry-references[open] > summary span {
    transform: rotate(45deg);
  }

  .industry-references__content {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
  }

  .gis-detail :global(.media-stage__frame) {
    background: transparent;
  }

  .gis-detail :global(.media-stage__frame img) {
    display: block;
    width: 100%;
    height: auto;
    background: transparent;
  }

  .gis-case :global(.prototype-frame) {
    overflow: visible;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .gis-case :global(.prototype-frame__chrome) {
    display: none;
  }

  .gis-case :global(.prototype-frame__viewport) {
    overflow: hidden;
    border-radius: var(--radius-media);
    background: transparent;
  }

  .gis-case :global(.prototype-frame__link) {
    margin: 0.75rem 0 0 auto;
  }

  .gis-case :global(.experience-diagram) {
    align-items: stretch;
  }

  .gis-case :global(.diagram-arrow) {
    align-self: center;
  }

  .tradeoff-note {
    display: grid;
    grid-template-columns: minmax(10rem, 13.5rem) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-media);
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-fold);
  }

  .tradeoff-note__meta {
    display: grid;
    gap: 0.5rem;
  }

  .tradeoff-note__tag {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: #ff6b27;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .tradeoff-note__tag::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .tradeoff-note__meta h3 {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .tradeoff-note p {
    color: color-mix(in srgb, var(--color-paper) 82%, var(--color-ink));
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .tradeoff-note strong {
    color: var(--color-paper);
    font-weight: 500;
  }

  @media (max-width: 45rem) {
    .tradeoff-note {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>

<script>
  const references = document.querySelector<HTMLDetailsElement>('.industry-references');
  const revealReferences = () => {
    if (references && location.hash === '#strategy') references.open = true;
  };

  revealReferences();
  window.addEventListener('hashchange', revealReferences);
  // 再次点击当前章节时不会触发 hashchange。
  document.querySelector('a[href="#strategy"]')?.addEventListener('click', () => {
    if (references) references.open = true;
  });
</script>

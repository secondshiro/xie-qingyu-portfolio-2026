---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import PrototypeFrame from '../../components/PrototypeFrame.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/real-estate-gis/media';
const prototypes = '/projects/real-estate-gis/prototypes';
const facts = [
  { label: '角色', value: '业务梳理、产品架构、UX 与交互原型' },
  { label: '输入', value: '需求规格、业务流程、旧系统截图与初版原型' },
  { label: '贡献', value: '让找楼、查看整幢和核对变更沿用同一栋楼的信息' },
  { label: '输出', value: '总图、整幢和实测替换预测三个可操作原型' },
  { label: '边界', value: '个人回溯重构 · 已完成交互原型' },
];
---

<SiteLayout
  title="房产 GIS 体验重构｜谢擎宇"
  description="从地图选中楼栋，继续查看整幢房屋或核对测绘变更的个人回溯重构案例。"
  current="work"
>
  <main class="case-page" id="main" tabindex="-1">
    <CaseHero
      title="房产 GIS 体验重构"
      summary="房产工作人员核对测绘变更时，要先找到楼栋，查看楼内房屋，再确认新旧房屋怎样对应。我从旧系统材料中重新梳理这几步操作，做成三个可操作原型，让工作人员找到楼以后，能带着当前楼栋的信息继续处理。"
      facts={facts}
    />

    <CaseToc />

    <CaseSection
      id="result"
      label="00 / 先看结果"
      title="选中 17 幢，继续查看房屋或核对变更"
      intro="演示以宇济一号 17 幢为例。选中这栋楼后，可以查看楼内的房屋，也可以进入测绘变更核对；名称、编号和属性会随入口保留。"
      tone="stone"
    >
      <PrototypeFrame
        src={`${prototypes}/map/index.html?restore=1&building=宇济一号&code=17幢`}
        title="房产 GIS 总图交互原型"
        poster={`${media}/final/map-current-overview.png`}
        posterAlt="总图中选中宇济一号 17 幢，左侧展开图层，右侧显示楼栋属性与业务入口"
        linkLabel="打开完整总图原型"
      />
      <div class="opportunity-path" aria-label="17 幢演示路径">
        <span>在地图找到 17 幢</span><i aria-hidden="true">→</i>
        <span>查看整幢房屋</span><i aria-hidden="true">→</i>
        <span>进入测绘变更核对</span>
      </div>
      <div class="case-copy">
        <p>这里的“幢”指一栋楼，楼内按房号管理的房屋称为“户室”。可以先从总图打开 17 幢，再选择查看整幢房屋或核对测绘变更。</p>
      </div>
    </CaseSection>

    <CaseSection
      id="origin"
      label="01 / 项目源头"
      title="一次技术升级给了我重新梳理路径的机会"
      intro="这个项目最初来自一次国产环境升级。旧系统的技术需要更换，我也借这个机会，把需求规格、业务流程、旧系统截图和初版原型放在一起核对。"
    >
      <div class="case-copy">
        <p>梳理这条操作路径时，我注意到，工作人员处理的仍是同一栋楼，切换模块后却要重新找到它。核对新旧户室和面积差异已经需要仔细判断，再确认一次楼栋，就又多了一步操作。我希望界面能保留已经选好的楼，让工作人员接着处理眼前的核对。</p>
        <p>有些材料写了功能，却没有讲清具体操作场景。我把文档写明的规则、截图中能看见的实现和这次提出的设计分开记录。能确认的流程先做成原型，材料不足的规则则留作后续问题，避免把设计推演写成既有业务事实。</p>
      </div>
      <div class="evidence-key" aria-label="证据分级">
        <div><b>Confirmed · 已确认</b><p>文档中已明确写出的业务规则。</p></div>
        <div><b>Observed · 已观察</b><p>旧系统截图中可以直接看见的界面实现。</p></div>
        <div><b>Inferred · 依据推导</b><p>由现有证据推导，仍待验证的内容。</p></div>
        <div><b>Redesigned · 本次重构</b><p>这次回溯重构提出的界面与操作方案。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="problem"
      label="02 / 问题重定义"
      title="切换模块后，还要重新确认同一栋楼"
      intro="找到楼栋以后，工作人员要从整幢房屋里定位户室，再核对它与新测绘结果的对应关系。旧系统把这些操作放在不同模块中，每次切换还需要重新确认楼栋。"
      tone="panel"
    >
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-map-observed.webp`}
          alt="旧系统总图，顶部排列地图工具，左侧为图层列表，中间显示楼栋地图"
          caption="旧总图已有图层、地图工具和业务入口。重构继续保留这些功能，并围绕选中的楼栋组织后续操作。"
          kind="observed"
          width={1600}
          height={1000}
        />
        <MediaStage
          src={`${media}/public/legacy-building-observed.webp`}
          alt="旧系统分层分户图，上方为平面区，左侧显示房屋属性，下方为彩色楼盘表"
          caption="旧楼盘表用颜色区分房屋状态，但户室主要集中在下半屏，上方平面区和左侧属性区也占用展示空间。"
          kind="observed"
          width={1600}
          height={1000}
        />
      </div>
      <div class="case-copy">
        <p>我把楼栋信息随入口保留下来，再按任务安排页面内容。地图负责定位，整幢页面集中展示楼层和户室；进入测绘变更后，再展开新旧关系的对照。每个页面可以专注当前任务，工作人员也能知道自己仍在处理哪栋楼。</p>
      </div>
    </CaseSection>

    <CaseSection
      id="workspaces"
      label="03 / 核心方案"
      title="找到楼以后，按任务查看房屋和核对变更"
      intro="这三个页面分别处理定位楼栋、查看整幢和核对测绘变更。下面以 17 幢为例，说明每一步要看哪些信息，后续操作又怎样衔接。"
      tone="stone"
    >
      <div class="workspace-stack">
        <article class="workspace">
          <header class="workspace__header">
            <span>01 / 空间 · 选幢</span>
            <div><h3>先找到楼，再查看它的属性和业务入口</h3><p>在总图中，工作人员先确认要处理哪栋楼。我让未选楼时的页面集中在查找和定位；选中 17 幢后，右侧再显示这栋楼的属性、历史和业务入口，方便从这里继续查看房屋或核对测绘变更。</p></div>
          </header>
          <div class="experience-diagram" aria-label="从地图选楼到查看楼栋信息的操作路径">
            <div class="diagram-node diagram-node--map"><span class="diagram-kicker">空间</span><b>地图定位</b><div class="map-sketch" aria-hidden="true"><i></i><i></i><i></i><i></i><b>17</b><span></span><span></span></div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--building"><span class="diagram-kicker">对象</span><b>选中 17 幢</b><div class="building-shape">17</div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--panel"><span class="diagram-kicker">继续工作</span><b>楼栋信息与操作</b><div class="panel-sketch" aria-hidden="true"><strong>宇济一号 · 17幢</strong><i></i><i></i><i></i><i></i></div></div>
          </div>
          <div class="workspace-notes"><div><b>保留什么</b><p>17 幢的名称、编号和属性留在右侧，业务入口也对应当前楼栋。</p></div><div><b>为什么这样做</b><p>先找到楼栋，再查看它的属性和可办理任务，查找时无需同时阅读所有业务信息。</p></div><div><b>接着做什么</b><p>从右侧入口查看整幢房屋，或核对这栋楼的测绘变更。</p></div></div>
          <a class="workspace__prototype-link" href={`${prototypes}/map/index.html?restore=1&building=宇济一号&code=17幢`} target="_blank" rel="noopener noreferrer">打开 17 幢的总图原型 ↗</a>
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>02 / 对象 · 看整幢</span>
            <div><h3>按楼层和单元查看整幢房屋</h3><p>进入整幢页面后，工作人员需要看清每层、每个单元有哪些房屋。我用矩阵，也就是按楼层和单元排列的表格，集中展示这些户室；实际层与名义层这两种楼层标记并列显示，便于对照。平面图仍放在侧栏，需要定位房屋时可以查看。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/public/legacy-building-overview-observed.webp`} alt="旧整幢页面同时保留顶部工具、左侧属性、上方平面区和下方楼盘表" caption="上方平面区、左侧属性和下方楼盘表同时保留，整幢户室集中在下半屏。" kind="observed" width={1600} height={1000} />
            <MediaStage src={`${media}/final/building-current-overview.png`} alt="宇济一号 17 幢的整幢页面，左侧显示平面参考和属性，右侧按楼层与单元排列户室" caption="平面参考放在侧栏，楼层与各单元的户室集中到右侧矩阵。" kind="redesigned" width={1440} height={900} />
          </div>
          <PrototypeFrame src={`${prototypes}/building/index.html?building=宇济一号&code=17幢&owner=1&room=1501`} title="分层分户图交互原型" poster={`${media}/final/building-current-overview.png`} posterAlt="宇济一号 17 幢的整幢页面，左侧显示平面参考和属性，右侧按楼层与单元排列户室" linkLabel="打开完整整幢房屋原型" />
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>03 / 任务 · 核对变更</span>
            <div><h3>先对照新旧户室，再确认测绘关系</h3><p>“实测替换预测”任务把已有的预测记录与新测绘的实测结果放在一起核对。工作人员需要判断两边的户室怎样对应，再查看面积差异。我用关系卡并列呈现现有户室与实测户室，把面积差异放在两者之间；遇到一拆多、多合一的情况，也先展示对应依据，再由工作人员确认。图中的差异数值用于演示，实际怎样判断仍需业务确认。</p></div>
          </header>
          <div class="experience-diagram experience-diagram--task" aria-label="从对照户室和面积到人工确认的核对路径">
            <div class="diagram-node diagram-node--relation"><span class="diagram-kicker">核对内容</span><b>现有户与实测户</b><div class="room-pair" aria-hidden="true"><span>1501室<br /><small>94.20㎡</small></span><em>?</em><span>1501室<br /><small>95.90㎡</small></span></div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--cards"><span class="diagram-kicker">判断依据</span><b>关系卡</b><div class="relation-card" aria-hidden="true"><span>面积差异</span><strong>+1.70㎡</strong><small>需人工核对</small></div></div>
            <span class="diagram-arrow" aria-hidden="true">→</span>
            <div class="diagram-node diagram-node--decision"><span class="diagram-kicker">人工确认</span><b>核对状态</b><div class="decision-state" aria-hidden="true"><span></span>待核对</div><small>确认后进入入库流程</small></div>
          </div>
          <PrototypeFrame src={`${prototypes}/task/index.html?building=宇济一号&code=17幢&from=gis&step=3&view=cards&filter=review`} title="实测替换预测交互原型" poster={`${media}/final/13-task-relations-focus.png`} posterAlt="测绘变更核对页面，以关系卡并列显示现有户室、测绘户室和面积差异" linkLabel="打开完整测绘变更核对原型" />
        </article>
      </div>
    </CaseSection>

    <CaseSection
      id="strategy"
      label="04 / 行业判断"
      title="参考其他产品，检查这三步怎样安排"
      intro="安排这三个页面时，我也参考了行业平台、空间产品和工作流产品。它们帮助我检查业务入口和信息组织，具体设计仍要回到工作人员正在处理的楼栋和任务。"
    >
      <details class="industry-references">
        <summary>查看三类产品的参照依据<span aria-hidden="true">＋</span></summary>
        <div class="industry-references__content">
          <div class="reference-grid">
            <article class="reference-card">
              <span>直接行业平台</span>
              <h3>找到楼栋后，要能继续进入具体业务</h3>
              <p>SuperMap 的公开方案涵盖不动产登记业务，我关注的是业务入口怎样组织。回到本案，工作人员选定楼栋后，应能找到与这栋楼有关的操作，因此我把入口放在总图右侧。</p>
              <a href="https://www.supermap.com/zh-cn/a/solutions/119_4553.html" target="_blank" rel="noopener noreferrer">SuperMap 公开资料 ↗</a>
            </article>
            <article class="reference-card">
              <span>空间产品参照</span>
              <h3>让地图先帮助工作人员找到楼</h3>
              <p>DataV Atlas 面向地理空间数据的展示与分析。我把它作为地图组织信息的参照，在本案中让总图先承担找楼和选楼，再展开楼栋信息。</p>
              <a href="https://help.aliyun.com/zh/datav/datav-atlas/product-overview/what-is-datav-atlas/" target="_blank" rel="noopener noreferrer">DataV Atlas 公开资料 ↗</a>
            </article>
            <article class="reference-card">
              <span>工作流产品参照</span>
              <h3>把复杂核对拆成可以逐项确认的内容</h3>
              <p>我参考飞书多维表格的分支与状态组织方式，检查复杂核对怎样拆开。在本案中，关系卡呈现户室对应和差异，确认动作仍由工作人员完成。</p>
              <a href="https://www.feishu.cn/product/base" target="_blank" rel="noopener noreferrer">飞书多维表格公开资料 ↗</a>
            </article>
          </div>
          <div class="opportunity-path" aria-label="从定位楼栋到核对变更的设计思路">
            <span>在地图找到楼栋</span><i aria-hidden="true">→</i>
            <span>保留当前楼栋信息</span><i aria-hidden="true">→</i>
            <span>继续核对业务关系</span>
          </div>
        </div>
      </details>
    </CaseSection>

    <CaseSection
      id="tradeoffs"
      label="05 / 设计取舍"
      title="保留业务信息，调整它们出现的位置"
      intro="旧系统的状态色、平面图和表格都承载着具体信息。重新安排页面时，我需要保留这些信息，也要让工作人员容易找到当前要看的内容。"
    >
      <div class="decision-grid">
        <article class="decision-card"><span>01</span><h3>状态色保留原有业务含义</h3><p>工作人员要区分房屋的业务状态，也要知道自己选中了哪一户。我保留原有状态色，固定图例顺序；一户有多种状态时，色带等分显示，当前选中则用独立描边表示。</p></article>
        <article class="decision-card"><span>02</span><h3>平面图用于定位，矩阵用于查看整幢</h3><p>平面图可以帮助定位具体房屋，查看整幢时还需要对照不同楼层。我把矩阵放在主要区域，平面图留在侧栏按需查看，让整幢户室有更完整的展示空间。</p></article>
        <article class="decision-card"><span>03</span><h3>先看户室关系，再核对具体字段</h3><p>核对变更时，工作人员既要判断户室怎样对应，也要逐项核对字段。关系卡先呈现对应和差异，需要逐项查字段时，仍可切换到表格。</p></article>
      </div>
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/15-decision-matrix.png`} alt="户室矩阵局部，实际层与名义层并列，各户室以色带表示业务状态" caption="实际层与名义层并列显示，各户室仍保留业务状态色带。" kind="redesigned" width={1190} height={380} />
        <MediaStage src={`${media}/final/16-decision-relation-card.png`} alt="关系卡局部，现有户室与测绘户室两侧排列，面积差异显示在中间" caption="现有户室与测绘户室并列，面积差异显示在中间，卡片同时标记待核对状态。" kind="redesigned" width={1190} height={190} />
      </div>
    </CaseSection>

    <CaseSection
      id="impact"
      label="06 / 价值与边界"
      title="原型已经能演示什么，还有什么需要验证"
      intro="目前完成的是三个可操作原型。它们可以演示围绕同一栋楼衔接操作、保留业务信息和逐项核对关系的方式；实际办理时间是否变化，仍需在真实使用中验证。"
      tone="panel"
    >
      <div class="value-grid">
        <article class="value-card"><span>连续操作</span><h3>切换模块后继续处理当前楼栋</h3><p>从 17 幢进入整幢或测绘变更任务后，名称、编号和属性继续保留。工作人员可以接着查看户室或核对关系，省去再次搜索和确认楼栋。</p></article>
        <article class="value-card"><span>业务信息</span><h3>查看房屋时，原有业务信息仍可对照</h3><p>状态色、实际层与名义层，以及户室字段继续保留。当前选中用单独的描边表达，工作人员可以分别查看房屋状态和自己的操作位置。</p></article>
        <article class="value-card"><span>规则核对</span><h3>待确认的问题有了具体页面可讨论</h3><p>面积差异怎样进入人工核对、户室之间怎样建议关联，都对应到原型中的具体位置，便于后续与业务人员一起核对规则。</p></article>
      </div>
    </CaseSection>

    <CaseSection
      id="ai-collaboration"
      label="07 / AI 协作"
      title="AI 协助整理和实现，业务判断由我负责"
      intro="AI 协助我读取材料、比较方案和实现原型。我负责核实事实，判断方案是否偏离业务，并决定哪些内容写进设计，哪些保留为待确认问题。"
    >
      <div class="boundary-grid">
        <article class="boundary-card"><h3>沿着三个原型继续核对方案</h3><p>总图、整幢和实测替换预测三个原型都有独立入口，可以作为后续核对业务规则的具体页面。</p><ul><li>总图呈现选楼后的信息与业务入口。</li><li>在整幢原型里，可以对照户室排列、状态色和楼层信息。</li><li>测绘变更原型用关系卡呈现对应依据，保留人工核对和任务状态。</li></ul></article>

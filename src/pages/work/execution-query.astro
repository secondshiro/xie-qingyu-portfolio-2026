---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';
import '../../styles/execution-query.css';

const facts = [
  { label: '角色', value: '独立完成产品判断、交互设计与工具实现' },
  { label: '交付', value: '本地查询工具、任务历史、Excel 导出与维护说明' },
  { label: '阶段', value: '本地重构完成，已用两项合成任务进行浏览器试用' },
];

const tocSections = [
  { id: 'origin', label: '01 / 需求起点' },
  { id: 'breakage', label: '02 / 网站变化' },
  { id: 'decision', label: '03 / 方案取舍' },
  { id: 'result', label: '04 / 查询过程' },
  { id: 'system', label: '05 / 结果与交付' },
  { id: 'evidence', label: '06 / 试用与维护' },
];
---

<style is:global>
  .responsibility-split strong {
    font-size: 1rem;
    font-weight: 500;
  }
  .product-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0 auto;
  }
  .product-pair figure {
    margin: 0;
  }
  .product-pair .product-evidence__frame {
    aspect-ratio: 16 / 9;
  }
  .product-pair .product-evidence__frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-pair__label {
    display: inline-block;
    margin-bottom: .5rem;
    color: var(--color-accent);
    font-size: .72rem;
    letter-spacing: .025em;
  }
  @media (max-width: 48rem) {
    .product-pair {
      grid-template-columns: 1fr;
    }
  }
  .evidence-note {
    margin: 0 0 2rem;
    padding: .75rem 1rem;
    border-left: 2px solid var(--color-accent);
    background: var(--color-panel);
    color: #8a2800;
    font-size: .82rem;
    line-height: 1.65;
  }
</style>

<SiteLayout title="执行网查询助手｜谢擎宇" description="从反复核查关联公司的需求开始，重新安排人工验证、批量查询与结果整理，让一份名单查完后能够继续核对和交付。" current="work">
  <main class="case-page execution-query-page" id="main" tabindex="-1">
    <CaseHero
      eyebrow="工具实践 · 查询与结果整理"
      title="执行网查询助手"
      summary="律师需要持续核查同一批关联公司有没有新增被执行案件，每次都要逐项输入、查看详情，再整理结果。我从单次查询做起，逐步做成一个本地工具；官网改变验证方式后，又重新安排人工验证与任务接续，让使用者能从已有名单和结果继续复核。"
      facts={facts}
    />
    <CaseToc title="执行网查询助手" sections={tocSections} />

    <CaseSection id="origin" label="01 / 需求起点" title="同一批公司，需要一次次重新查询" intro="这项需求来自法律从业者对关联公司的持续复核。上次查过，并不意味着这次可以省略；使用者需要知道有没有新增被执行案件，也要打开详情核对具体情况。">
      <div class="case-copy">
        <p>我先让输入一个名称后读取列表和详情的过程跑通。单次查询能用以后，一批名单还需要排队处理，结果也要留下来供下次比较。后续几代围绕这些需要逐步补齐功能。</p>
      </div>
      <ol class="iteration-line" aria-label="工具四代演进">
        <li><span>V1</span><div><strong>单次查询跑通</strong><p>输入一个名称，结果直接显示在下方，适合逐项查询。</p></div></li>
        <li><span>V2</span><div><strong>名单排队与历史</strong><p>加入批量名单和本地历史。左侧保留名单，右侧显示进度，便于核对当前查到哪一项。</p></div></li>
        <li><span>V3</span><div><strong>状态颜色区分</strong><p>旧版用不同颜色标注新增与撤销记录，开始把前后变化单独呈现。</p></div></li>
        <li><span>V4</span><div><strong>详情与导出</strong><p>补齐详情、截图和 Excel 导出，增加变化比较面板，供查询后核对与留档。</p></div></li>
      </ol>
      <div class="case-copy">
        <p>查询量从一项变成一批后，使用者需要同时看名单和每项进度。结果区再保留变化比较，就可以查完后接着核对，不必另找上次的记录。</p>
        <p>功能逐步加在旧工具上，读取网站的代码与展示界面也越来越难分开。官网更新验证流程后，我需要重新梳理两者怎样配合。</p>
      </div>
      <p class="evidence-note">下面五张截图来自工具的真实界面，公司名称、案号和金额使用固定合成数据。工具在本机处理真实查询，公开页面只展示合成示例。</p>
      <div class="product-pair" data-protected-media>
        <figure class="product-evidence" data-evidence-kind="real-product-synthetic-data">
          <p class="product-pair__label">V1 · 旧工具</p>
          <div class="product-evidence__frame">
            <img
              src="/projects/execution-query/v1-interface-synthetic.webp"
              width="1440"
              height="960"
              alt="旧工具 V1 界面，单列居中布局，单次查询输入框与结果列表"
              draggable="false"
            />
          </div>
          <figcaption class="artifact-caption">
            <span>真实产品·合成数据</span>
            旧版在输入框下方显示结果，一次查询一个名称。
          </figcaption>
        </figure>
        <figure class="product-evidence" data-evidence-kind="real-product-synthetic-data">
          <p class="product-pair__label">当前 · 本地控制台</p>
          <div class="product-evidence__frame">
            <img
              src="/projects/execution-query/console-synthetic.webp"
              width="1440"
              height="960"
              alt="当前控制台界面，左右双区域布局，左侧批量名单，右侧任务进度与变化比较"
              draggable="false"
            />
          </div>
          <figcaption class="artifact-caption">
            <span>真实产品·合成数据</span>
            当前控制台左侧保留整批名单，右侧显示进度和变化比较。
          </figcaption>
        </figure>
      </div>
    </CaseSection>

    <CaseSection id="breakage" label="02 / 网站变化" title="官网变了，原来的查询方式难以继续" intro="官网把字符图片验证换成随机滑块和文字点选。变化还影响了后续查询，列表、翻页与详情都需要在完成验证的浏览器里继续，旧工具无法按原来的方式读取结果。" tone="panel">
      <div class="breakage-sequence">
        <article>
          <span>旧验证方式</span>
          <h3>字符图片验证码</h3>
          <p>提交名称后识别图片中的字符，验证和查询在同一个请求中完成。</p>
        </article>
        <article>
          <span>新验证方式</span>
          <h3>随机滑块与文字点选</h3>
          <p>题型包含旋转字形，还会校验操作行为，旧字符识别方式难以接着使用。</p>
        </article>
        <article>
          <span>状态依赖</span>
          <h3>后续操作要留在同一浏览器</h3>
          <p>网站将验证结果与当前浏览器会话关联，也就是同一次访问保留的状态。后续读取结果需要接着使用它。</p>
        </article>
      </div>
      <div class="case-copy">
        <p>我尝试过本地图像识别，也检查了可复用的开源项目。当时的尝试仍不足以稳定处理新题型，继续投入还需要模型、图像处理和反复调参。</p>
        <p>同时，读取结果也需要跟着官网页面操作。下一版工具需要考虑怎样在浏览器里接续整批查询，单独修补识别已经不够。</p>
      </div>
    </CaseSection>

    <CaseSection id="decision" label="03 / 方案取舍" title="把人工验证留在官网，工具接着做重复工作" intro="保留人工验证意味着使用者要在中途接管页面。我接受这一步操作，把设计重点放在验证后怎样继续，避免使用者回来重新开始整批任务。">
      <div class="case-copy">
        <p>逐项查询和整理结果是这项需求里反复发生的工作。我停止了验证码识别尝试，让人按官网要求完成验证，工具负责名单排队和后续整理。也没有采用第三方打码服务，以免增加费用、外部依赖与隐私问题。</p>
        <p>我让控制台保留当前查询项和剩余名单，浏览器负责接着读取官网结果。人完成验证后，这两部分仍对应同一批任务，已经提交的名单不必再填一次。</p>
      </div>
      <div class="responsibility-split">
        <section class="responsibility-split__human">
          <span>人</span>
          <strong>完成安全验证</strong>
          <p>在执行网页面完成随机滑块或文字点选，再让工具接着查询。</p>
        </section>
        <section>
          <span>工具</span>
          <strong>批量接续与结果整理</strong>
          <p>先整理名单并排队，再读取列表与详情。查询结果保存为任务历史，供变化比较和三表 Excel 导出。</p>
        </section>
      </div>
    </CaseSection>

    <CaseSection id="result" label="04 / 查询过程" title="提交名单后，只在需要验证时转到官网" intro="使用者从本地控制台开始，不必提前打开执行网。工具会自动打开或复用查询页，遇到验证时请人接管，完成后继续当前项和剩余名单。" tone="stone">
      <ol class="handoff-flow" aria-label="查询助手工作流">
        <li><span>01</span><strong>提交名单</strong><p>每行填写姓名或机构名称，先处理空行和重复项。</p></li>
        <li class="handoff-flow__human"><span>02</span><strong>完成验证</strong><p>安全验证由人完成，操作留在执行网页面。</p></li>
        <li><span>03</span><strong>接着查询</strong><p>工具使用当前页面，继续读取列表与案件详情。</p></li>
        <li><span>04</span><strong>查看整批结果</strong><p>回到控制台，查看哪些已完成、哪些需要重查。</p></li>
      </ol>
    <figure
      class="product-evidence"
      data-evidence-kind="real-product-synthetic-data"
      data-protected-media
    >
      <div class="product-evidence__frame">
        <img
          src="/projects/execution-query/verification-waiting-synthetic.webp"
          width="1440"
          height="1530"
          alt="执行网查询助手控制台等待验证状态，橙色提示条显示请在执行网页面完成安全验证，任务进度停在 0/2"
          draggable="false"
        />
      </div>
      <figcaption class="artifact-caption">
        <span>真实产品·合成数据</span>
        等待验证时，橙色提示条说明需要去官网操作，当前任务和 0 / 2 进度仍保留。画面使用固定合成数据。
      </figcaption>
    </figure>
      <div class="case-copy">
        <p>如果中途暂停，之后可以从当前任务继续。需要重新处理未完成项时，已经取得的结果会保留，使用者不用为了补查几项再跑一遍整批名单。</p>
      </div>
    </CaseSection>

    <CaseSection id="system" label="05 / 结果与交付" title="没查到记录，和没查完，要分开告诉使用者" intro="一批查询结束后，使用者首先要判断哪些结果可以核对。官网明确返回空结果，才能算无记录；验证超时、连接失败或页面变化，都只能说明这次还没查完。">
      <div class="result-ledger" aria-label="查询结果的三种语义">
        <div><span class="result-ledger__dot result-ledger__dot--done"></span><strong>有记录</strong><p>查看已取得的案件列表和详情。</p></div>
        <div><span class="result-ledger__dot result-ledger__dot--empty"></span><strong>无记录</strong><p>本次查询完成，官网返回明确空结果。</p></div>
        <div><span class="result-ledger__dot result-ledger__dot--failed"></span><strong>未完成</strong><p>查看中断原因，之后重新查询。</p></div>
      </div>
      <div class="case-copy">
        <p>这个区别也用于前后两次的变化比较。如果将失败记成空结果，上次查到的案件就可能被误认为已经消失。工具只比较成功查询留下的记录，区分首次记录、新增、存续和本次未见；未完成项留待重查。本次未见只说明这次没有取得上次的记录，案件的实际情况仍需核对。</p>
        <p>导出把核对工作分在三张表里。查询汇总供查看每个对象的结果，案件明细供逐条复核，未完成项用于安排重查。字段固定后，使用者可以直接筛选与查看详情，结果怎样用于后续工作仍由律师判断。</p>
      </div>
      <figure
        class="product-evidence"
        data-evidence-kind="real-product-synthetic-data"
        data-protected-media
      >
        <div class="product-evidence__frame">
          <img
            src="/projects/execution-query/export-synthetic.webp"
            width="1440"
            height="650"
            alt="执行网查询助手导出的 Excel，展示查询汇总、案件明细和未完成三张工作表"
            draggable="false"
          />
        </div>
        <figcaption class="artifact-caption">
          <span>真实产品·合成数据</span>
          Excel 分为查询汇总、案件明细和未完成三张工作表，供分别查看与筛选。画面使用固定合成数据。
        </figcaption>
      </figure>
    </CaseSection>

    <CaseSection id="evidence" label="06 / 试用与维护" title="从提交名单到导出，实际走了一遍" intro="2026 年 9 月 12 日，我用两项合成任务在真实浏览器中检查了这条流程。" tone="stone">
      <div class="case-copy" data-field-trial>
        <p>名单从控制台提交后，工具准备好官网查询页。使用者通过文字点选完成一次人工验证，第一项取得案件列表和 1 / 1 详情，第二项接着使用同一页面，确认无记录。最终 2 / 2 项完成、0 项失败，导出的三张工作表也检查了结构、公式错误和显示情况。</p>
        <p>这次试用覆盖两项任务，验证了当时从查询到导出的流程。样本只代表这次小范围检查，后续批次仍需观察；官网改变页面或验证流程后，也要重新核对。</p>
      </div>
    <figure
      class="product-evidence"
      data-evidence-kind="real-product-synthetic-data"
      data-protected-media
    >
      <div class="product-evidence__frame">
        <img
          src="/projects/execution-query/trial-completion-synthetic.webp"
          width="1440"
          height="1728"
          alt="执行网查询助手控制台完成状态，显示 2/2 项完成、1 项有记录、1 项无记录，以及与上次查询的变化比较"
          draggable="false"
        />
      </div>
      <figcaption class="artifact-caption">
        <span>真实产品·合成数据</span>
        完成状态显示 2 / 2 项完成、0 项失败，一项有记录、一项无记录，旁边保留变化比较。画面使用固定合成数据。
      </figcaption>
    </figure>
      <div class="case-copy">
        <p>交付包括本地控制台、任务历史、Excel 导出与维护说明。说明记录了浏览器怎样接续任务，以及超时、断连和页面变化时该检查什么，供后续定位出错步骤并核对查询是否恢复。</p>
      </div>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">欢迎交流名单接续与结果交付的设计</h2>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
        <a href="mailto:second988@qq.com">邮件联系</a>
      </div>
    </section>
  </main>
</SiteLayout>

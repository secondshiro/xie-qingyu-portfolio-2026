---
import EdgecaseDemo from '../../components/EdgecaseDemo.astro';
import DesignEvidence from '../../components/DesignEvidence.astro';
import RedetectionDemo from '../../components/RedetectionDemo.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';
import '../../styles/edgecase-examples.css';
const media = '/projects/edgecase-planner';
const sections = [
  { id: 'origin', label: '01 / 经验起点' },
  { id: 'evolution', label: '02 / 分开检查两项操作' },
  { id: 'change-review', label: '03 / 确认重新检测的后果' },
  { id: 'arco', label: '04 / 补上输入检查' },
];
const facts = [
  { label: '角色', value: '提炼检查规则，组织评审流程，确认业务要求与修改范围' },
  { label: '工具', value: 'Edgecase Planner · 给 AI 使用的设计检查规则' },
  { label: '产出', value: 'Plan / Review 规则、评审记录与版本对照' },
  { label: '阶段', value: '个人工具实践 · 持续迭代' },
];
---
<SiteLayout title="把设计经验整理成可复用的 AI 工作流｜谢擎宇" description="从实际设计问题整理检查规则，展示上传与预审的输入拆分、变化检测中的人工判断，以及输入校验规则的补充。" current="work">
  <main class="case-page edgecase-page" id="main" tabindex="-1">
    <CaseHero eyebrow="AI 工作流 · 设计检查规则" title="把设计经验整理成可复用的 AI 工作流" summary="我写了一套给 AI 使用的设计检查规则。评审上传与预审流程时，它把两项操作混在一起追问。我修改了检查指令和材料组织方式，再用保留的输入核对答复是否分开。" facts={facts} />
    <CaseToc title="Edgecase Planner" sections={sections} />
    <CaseSection id="origin" label="01 / 经验起点" title="从下载任务里的遗漏开始" intro="在无人机巡查后台，表头全选只覆盖当前页，打包时没有反馈，取消保存后又无法重新下载。我把这些遇到过的问题写成检查规则，交给 AI 对照设计稿继续查。">
      <details class="review-source-note"><summary>查看下载任务中的三个问题</summary>
      <div class="origin-examples">
        <article><div class="example-copy"><span class="proof-label">01 / 范围</span><h3>选了“全部”，却只包含当前页</h3><p>用户想下载整轮巡查成果，表头全选却只覆盖当前页的 10 条。翻页后，之前的选择也没有保留。</p></div><EdgecaseDemo mode="selection" resetOnPage /></article>
        <article><div class="example-copy"><span class="proof-label">02 / 反馈</span><h3>点击下载后，不知道是否已经开始</h3><p>文件需要先打包，点击后却没有反馈，用户难以判断该继续等还是重新操作。当时增加了数量和百分比提示，让处理进度变得可见。</p></div><EdgecaseDemo mode="download" /></article>
        <article><div class="example-copy"><span class="proof-label">03 / 恢复</span><h3>取消保存后，无法重新下载</h3><p>多次点击下载再取消保存，系统却提示“已下载”。文件没有拿到，任务也无法继续。</p></div><EdgecaseDemo mode="recovery" /></article>
      </div></details>
    </CaseSection>
    <CaseSection id="evolution" label="02 / 分开检查两项操作" title="“上传完成”之后，预审可能才开始" intro="材料提交包含上传文件和检查材料两项操作。我最初把它们放在同一份材料里，AI 只问一次“如何完成”。这一次修改针对检查方法，下面用流程示意说明它混淆了什么。" tone="panel">
      <div class="method-example"><EdgecaseDemo mode="upload" /><div class="example-copy"><h3>文件传完与材料通过，是两件事</h3><p>上传需要告诉用户文件有没有传成功；预审需要说明检查到了哪一步、材料是否需要修改。</p><p>即使它们出现在同一个流程里，等待方式和失败处理也可能不同。我按能否独立回答这些问题来划分检查范围。</p></div></div>
      <div class="question-compare">
        <article><span class="proof-label">原输入与输出</span><h3>五张画面，共用一组追问</h3><p>上传与预审放进同一份输入，实际输出只有一个待确认项。上传入口和四张预审状态画面都归到这一项里。</p></article>
        <article><span class="proof-label">拆分后的实际输出</span><h3>两项操作，分别保留答复</h3><p>上传独立检查；预审的等待、通过、失败与返回修改仍放在一起。两项分别询问完成方式，使用各自的检查编号。</p></article>
      </div>
      <div class="case-copy"><h3>改指令时，先约束输入怎样整理</h3><p>工具原本就支持分别检查两项操作。我先修改了交给 AI 的指令，要求上传和预审各自保存材料与答复。同一次预审的等待、通过和失败画面仍放在一起。</p></div>
      <section class="rule-verification" aria-labelledby="rule-verification-title">
        <header><span class="proof-label">2026 年 9 月 · 固定合成答复检查</span><h3 id="rule-verification-title">给两步不同的答案，检查它们会不会串答</h3><p>我另外设定上传即时完成、预审在后台处理，检查两种答复各自进入了哪些规则。</p></header>
        <dl>
          <div><dt>上传 · 即时完成</dt><dd>收到即时完成的答复后，AI 结束了上传这一步的等待追问。</dd></div>
          <div><dt>预审 · 后台处理</dt><dd>AI 继续追问预审进度怎样显示，结束后如何通知，以及失败或重复提交时怎样处理。</dd></div>
          <div><dt>同一预审的四张状态画面</dt><dd>保持在一项操作里检查；静态文案样本则没有触发等待与恢复规则。</dd></div>
        </dl>
        <p>控制检查把两项操作重新合并，仍只得到一组追问。因此，分别整理操作必须成为每次调用前的一步。</p>
        <div class="record-links"><a href={`${media}/review-records.json`} target="_blank" rel="noopener">查看原始输入、输出与指令节选 ↗</a><a href={`${media}/rule-revision-notes.txt`} target="_blank" rel="noopener">阅读中文验证摘要 ↗</a></div>
      </section>
      <details id="method" class="review-source-note"><summary>查看检查方法与航线选择例子</summary>
      <div id="direction" class="case-copy"><p>最初我考虑开发 Figma 插件，后来先把检查方法写成 Skill，借用 AI 助手读图和操作页面。这样可以先检查问题是否问得对；每次仍需准备设计稿与业务说明。</p><p>设计前用 Plan 梳理需要考虑的情况，设计后用 Review 对照画面和操作检查。输入除了设计材料，还包括已确认的业务要求；缺少答复的地方先留下问题。</p></div>
      <ol class="review-flow">
        <li><span>01</span><h3>观察</h3><p>保留具体画面和操作，找到需要核对的位置。</p></li>
        <li><span>02</span><h3>追问</h3><p>把材料无法回答的业务问题交给设计师。</p></li>
        <li><span>03</span><h3>确认</h3><p>根据答复判断问题是否成立，再提出建议。</p></li>
        <li><span>04</span><h3>回查</h3><p>改过规则以后，用保留的输入核对输出。</p></li>
      </ol>
      <details id="flight" class="review-source-note">
        <summary>一条业务答复怎样改变建议 · 航线选择</summary>
        <div class="case-copy"><p>航线弹窗能勾选多条，确认区域却只显示一条。AI 先问一个计划允许几条航线；我确认只允许一条后，建议把航线改为互斥单选，文件夹只负责展开和折叠。</p></div>
        <div class="evidence-grid">
          <DesignEvidence id="flight-picker" title="航线选择原稿" src={`${media}/flight-picker.png`} alt="航线选择弹窗使用复选框" caption="弹窗中的复选框允许同时勾选多条航线。" width={784} height={1784} />
          <DesignEvidence id="flight-summary" title="航线确认区域" src={`${media}/flight-summary.png`} alt="确认区域展示一条航线" caption="确认区域只展示一条，评审据此追问允许的数量。" width={760} height={540} />
        </div>
      </details>
      </details>
    </CaseSection>
    <CaseSection id="change-review" label="03 / 确认重新检测的后果" title="一次重新检测，会怎样影响人工修正？" intro="变化检测先由 AI 标出两次拍摄的差异，再由用户调整区域和标签。画面里同时有重新检测与人工编辑入口，AI 据此追问已有修改会怎样处理。">
      <DesignEvidence id="change-result" title="变化检测结果原稿" src={`${media}/change-review/waypoint-result.png`} width={1920} height={952} alt="变化检测结果页，左侧有 AI 与手动统计及重新检测按钮，右侧可编辑区域和标签" caption="左下角可以重新检测，右侧可以修正区域和标签。这两处操作成为本次追问的线索。" />
      <div class="review-supplement__trace">
        <article><span class="proof-label">AI 追问</span><h3>重新检测后，人工修正还在吗？</h3><p>画面能看到这两类操作，却无法说明重新计算后如何处理已有标注。AI 先问清这条业务规则。</p></article>
        <article><span class="proof-label">业务确认</span><h3>手动处理会被清空</h3><p>我确认用户可以删框、改框、补画和打标签，重新检测会清空此前的手动处理。</p></article>
        <article><span class="proof-label">设计建议</span><h3>执行前说明后果，允许取消</h3><p>人工修正被清空，意味着已经做过的核查需要重做。AI 据此提出确认方案，在执行前说明影响，并留下取消入口。</p></article>
      </div>
      <RedetectionDemo />
      <div class="case-copy review-verification"><p>这份建议稿把“清空”写进确认按钮，默认焦点放在取消上。交互检查中，取消保留当前处理，确认后才清空。</p></div>
      <details class="review-source-note">
        <summary>区分检测失败与源照片缺失</summary>
        <div class="case-copy"><p>我确认缺图发生在查看历史结果时，原照片已被删除；成功、失败和偏差来自供应商检测服务。缺少原照片会影响人工对照，因此需要单独解释照片的状态。</p></div>
        <DesignEvidence id="change-missing" title="历史结果照片缺失原稿" src={`${media}/change-review/photo-missing.png`} width={1920} height={952} alt="历史变化检测结果中，一侧原照片不存在，另一侧仍显示检测信息" caption="设计稿中的源照片缺失状态。" />
      </details>
    </CaseSection>
    <CaseSection id="arco" label="04 / 补上输入检查" title="写在提示里的限制，真的生效了吗？" intro="前面的例子主要涉及选择与等待，我又用 Arco 的分步表单检查这套方法能否覆盖输入问题。从填写基础信息到渠道配置，再返回修改，我逐步核对提示和实际表现。">
      <DesignEvidence id="arco-form" title="Arco 分步表单" src={`${media}/arco-form.webp`} alt="Arco 分步表单中的基础信息和链接填写区域" caption="分步表单中的链接字段是本次输入检查的对象。" width={640} height={427} label="操作页面" />
      <figure class="arco-trace">
        <figcaption><span class="proof-label">分步表单 / 实际操作记录</span><a href="https://react-pro.arco.design/form/step" target="_blank" rel="noreferrer">打开官方演示 ↗</a></figcaption>
        <ol>
          <li><span>01 / 留空后继续</span><strong>必填项拦截</strong><p>名称与推广时间留空，点击下一步，字段下出现对应提示，停留在当前步骤。</p></li>
          <li><span>02 / 前进再返回</span><strong>输入仍保留</strong><p>补全后进入渠道配置再返回，名称、日期和链接仍保留。再次前进，渠道来源也仍在。</p></li>
          <li><span>03 / 输入错误格式</span><strong>仍可进入下一步</strong><p>链接填入 not-a-url，页面没有按提示中的协议要求拦截，仍进入渠道配置。</p></li>
        </ol>
      </figure>
      <div class="question-compare">
        <article><span class="proof-label">观察到的差异</span><h3>“必须以 http:// 或 https:// 开头”，却允许普通文本通过</h3><p>表单写出了明确要求，实际校验却没有在下一步前落实。用户可能到后续环节才发现链接不可用，需要返回修改。</p><p>建议在字段旁提示格式错误，并在进入下一步前完成校验；保留其他已填内容，让用户只修正出错字段。</p></article>
        <article><span class="proof-label">规则补充与回查</span><h3>把漏掉的检查补成输入约束规则</h3><p>旧规则漏掉了格式检查。我补上“输入限制与纠错”，要求 AI 对照字段提示检查错误输入，继续核对修正后能否提交。</p><p>回查时，只给静态画面，结果先停在待确认；补入实际操作记录后，才确认这一项格式问题。版本和测试条件保留在<a href={`${media}/rule-revision-notes.txt`} target="_blank" rel="noopener">验证摘要</a>中。</p></article>
      </div>
      <div id="boundary" class="case-copy"><p>我负责检查问题的取舍与规则修订，AI 协助读图、执行检查和保存记录。这些输入与输出随版本保留，供下一次修改时对照。</p></div>
    </CaseSection>
    <section class="site-container case-closing" aria-labelledby="closing-title"><h2 id="closing-title">继续看看其他作品</h2><div class="case-closing__links"><a href="/#selected-work">返回作品索引</a></div></section>
  </main>
</SiteLayout>
<style>
.proof-label{color:var(--color-accent);font-size:12px;}
.review-supplement__trace{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;}
.review-supplement__trace article{border-top:1px solid var(--color-line);padding-top:1.25rem;}
.review-supplement__trace h3{font-size:18px;font-weight:500;margin:.75rem 0;}
.review-supplement__trace p{font-size:15px;color:var(--color-muted);}
.review-source-note{display:grid;gap:1.5rem;}
.review-source-note summary{min-height:44px;cursor:pointer;color:var(--color-accent);font-size:14px;}
.review-source-note[open]>.case-copy{margin-block:1.5rem;}
.review-source-note .evidence-grid{margin-top:1.5rem;}

.rule-verification{display:grid;gap:1.5rem;padding:2rem;background:var(--color-paper);border-radius:var(--radius-media);}
.rule-verification h3{font-size:18px;font-weight:500;margin:.75rem 0;}
.rule-verification p{font-size:15px;color:var(--color-muted);margin:0;}
.rule-verification dl{margin:0;display:grid;gap:1rem;}
.rule-verification dl>div{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:1.5rem;border-top:1px solid var(--color-line);padding-top:1rem;}
.rule-verification dt{font-size:15px;font-weight:500;}
.rule-verification dd{font-size:15px;margin:0;color:var(--color-muted);}
.record-links{display:flex;flex-wrap:wrap;gap:.75rem 2rem;}
.question-compare code{font-size:12px;overflow-wrap:anywhere;color:var(--color-muted);}
.rule-verification a{font-size:14px;color:var(--color-accent);}

.review-flow{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;padding:0;margin:0;gap:2rem;}
.review-flow li{border-top:1px solid var(--color-line);padding-top:1.25rem;}
.review-flow span{font-size:12px;color:var(--color-accent);}
.review-flow h3{font-size:18px;font-weight:500;margin:.75rem 0;}
.review-flow p{font-size:15px;color:var(--color-muted);}
@media(max-width:63.125rem){.review-flow{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:45rem){.rule-verification{padding:1.25rem;}.rule-verification dl>div{grid-template-columns:1fr;gap:.5rem;}.review-supplement__trace{grid-template-columns:1fr;}.review-flow{gap:1.5rem;}}
</style>

---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import BrandAuxiliary from '../../components/BrandAuxiliary.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/brand-system/media';
const facts = [
  { label: '角色', value: '梳理旧物料问题，设计品牌视觉规范与制作模板' },
  { label: '输入', value: '已投产的展会与印刷物料、业务方向、视觉需求清单' },
  { label: '贡献', value: '确定四种标识组合与选用表，整理颜色、字体和各类物料的制作规则' },
  { label: '输出', value: '品牌规范，外加 6 个子系统的模板和物料设计' },
  { label: '阶段', value: '旧物料已投产；新规范、模板与物料方案均为提案' },
];

const tocSections = [
  { id: 'result', label: '00 / 先看结果' },
  { id: 'origin', label: '01 / 项目源头' },
  { id: 'problem', label: '02 / 问题重定义' },
  { id: 'direction', label: '03 / 关键判断' },
  { id: 'auxiliary', label: '04 / 辅助图形' },
  { id: 'language', label: '05 / 视觉语言' },
  { id: 'crossmedia', label: '06 / 跨媒介扩展' },
  { id: 'ai-collaboration', label: '07 / AI 协作' },
  { id: 'boundary', label: '08 / 交付与边界' },
];
---

<SiteLayout
  title="新禾智飞品牌系统提案｜谢擎宇"
  description="从已投产的展会与印刷物料出发，设计四种标识组合的选用表、颜色与字体分级和物料模板，形成一套品牌规范与六个子系统提案。"
  current="work"
>
  <main class="case-page" id="main" tabindex="-1">
    <CaseHero
      eyebrow="提案案例 · 品牌与视觉系统"
      title="新禾智飞品牌系统提案"
      facts={facts}
    >
      <Fragment slot="summary">低空科技企业的海报、展板与印刷品由不同供应商分批制作，标识、字号和配色各有做法。我把四种标识组合、场景选用、颜色占比和字体层级<strong>写成可查的规范</strong>，配套六个子系统的模板与物料提案。</Fragment>
    </CaseHero>

    <div class="site-container case-cover">
      <MediaStage
        src={`${media}/final/05-identity-combinations.jpg`}
        alt="英文标识横版与竖版组合的比例、留白和最小尺寸规范"
        caption="比例与留白按标识高度 X 的倍数标注，最小尺寸区分印刷与屏幕，横版和竖版各有下限。"
        kind="proposal"
        width={1600}
        height={900}
        priority
      />
    </div>

    <CaseToc title="新禾智飞品牌系统提案" sections={tocSections} />

    <CaseSection
      id="result"
      label="00 / 先看结果"
      title="一张工作证怎样用到四组规则"
      intro="以工作证提案为例，制作人员可按四步查用规范，从选场景和标识，到套版式、核印刷规格。"
      tone="stone"
    >
      <div class="evidence-key" aria-label="工作证规范使用说明">
        <div><b>01　查场景</b><p>按“活动现场”场景在选用表定位对应行。</p></div>
        <div><b>02　选标识</b><p>按版面尺寸和中英文需求，从首选与次选中选定组合。</p></div>
        <div><b>03　套版式</b><p>套用工作证版式模板填入照片、姓名与身份。</p></div>
        <div><b>04　核规格</b><p>核对标识最小尺寸、留白和印刷色值，供打样时复核。</p></div>
      </div>
      <MediaStage
        src={`${media}/final/14-material-badge.jpg`}
        alt="工作证提案效果图，正面排列照片、姓名、工作人员身份与标识，背面放置二维码"
        caption="正面安排照片、姓名与人员身份，背面放展会资料二维码与证件编号。"
        kind="proposal"
        width={1600}
        height={900}
      />
    </CaseSection>

    <CaseSection
      id="origin"
      label="01 / 项目源头"
      title="新一批物料，又要重新决定标识和版式"
      intro="已投产的展会与印刷物料由不同供应商分批制作，标识、颜色和版式各有做法。"
    >
      <div class="case-copy">
        <p>海报与展板的比例可以随内容调整，标识位置、正文字体和标题层级则有共用规则的空间。</p>
        <p>我把可沿用的判断从单份设计稿提取为规范，让制作人员换内容时可以先查规则再排版。</p>
      </div>
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-drone-poster-observed.jpg`}
          alt="已投产的旧品牌海报，画面含无人机遥感网与低空治理文案"
          caption="旧海报用两行大标语加设备实拍介绍业务，整个版面留给一句业务说明，没有第二层信息。"
          kind="observed"
          width={1800}
          height={2310}
        />
        <MediaStage
          src={`${media}/public/legacy-product-wall-observed.jpg`}
          alt="旧横版展板的主营业务截图墙"
          caption="同一块展板并排三个业务板块，每个板块下再挂多张产品截图，标题层级与截图尺寸各不相同。"
          kind="observed"
          width={1800}
          height={673}
        />
      </div>
    </CaseSection>

    <CaseSection
      id="problem"
      label="02 / 问题重定义"
      title="把每次制作要做的选择写成规则"
      intro="我把反复出现的选择写进选用表和模板，回答用哪个标识、怎样区分字号、图文各放在哪。"
      tone="panel"
    >
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-intro-text-observed.jpg`}
          alt="旧企业介绍展板，蓝底上排列多段白色正文，顶部标题已模糊处理"
          caption="四段正文用相近字号连续排在蓝色底上，标题与正文之间没有明显的字号差。"
          kind="observed"
          width={1800}
          height={825}
        />
        <MediaStage
          src={`${media}/public/legacy-stats-band-observed.jpg`}
          alt="旧展板中的数字堆叠带，包含 10+、1000+、200+ 等资质数字"
          caption="八个资质数字并排、字号一致，单位说明小一号，整条带子没有层级区分。"
          kind="observed"
          width={1800}
          height={433}
        />
      </div>
      <div class="case-copy">
        <ul class="case-points">
          <li><strong>旧版</strong>四段企业介绍的字号相近，八个资质数字等大并排，重点难以区分。</li>
          <li><strong>新规范</strong>为标题、正文和说明分别指定字体、字重与间距，数字和英文单独配字体，换内容时沿用对应层级。</li>
        </ul>
      </div>
    </CaseSection>

    <CaseSection
      id="direction"
      label="03 / 关键判断"
      title="先查使用场景，再选合适的标识组合"
    >
      <Fragment slot="intro">保留四种标识组合，<strong>选用表把行分成两层</strong>。场景层包括平面物料、活动、网页和海外物料。应用层包括精品、无人机本体和联合品牌。横向列出四种组合，交叉格标出首选和次选。</Fragment>
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/04-identity-rationale.jpg`} alt="品牌标识释义页，标出左右对称轴与上下对称轴" caption="标识由字母 X 与 H 组合，释义页标出左右与上下两条对称轴，四种组合都以这个基础形为准。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/06-identity-construction.jpg`} alt="标识选用表，按场景列出首选和次选组合" caption="每一类场景标出首选和次选，制作人员先查场景所在的行，再横向找到对应的组合。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/03-context-scenes.jpg`} alt="常用组合标识运用示意，把标识放进展位画面、横版海报与竖版画面" caption="运用示意图把同一组标识放进几种版面，标识位置随版面方向变化。" kind="proposal" width={1600} height={900} />
      </div>
      <div class="workspace-notes">
        <div><b>为什么是四种</b><p>中英文与品牌、产品两条应用线各有组合，四种即可覆盖常见版面。</p></div>
        <div><b>怎样选用</b><p>先查对应场景的首选和次选，再根据版面方向与可用空间决定。</p></div>
        <div><b>制作前核对</b><p>制作前核对最小尺寸与安全留白，避免标识缩得过小或贴近文字。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="auxiliary"
      label="04 / 辅助图形"
      title="把标识折角延伸成辅助图形"
      intro="从标识的斜向笔画与内折角提取出“双折面”辅助图形，呼应低空飞行的方向感，用于海报与封面边缘收束版面。"
    >
      <BrandAuxiliary />
    </CaseSection>

    <CaseSection
      id="language"
      label="05 / 视觉语言"
      title="选好标识，再查颜色和字体"
      intro="颜色和字体按用途分层，色值、占比、字号与间距可以查规范取用。"
      tone="stone"
    >
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/07-color-system.jpg`} alt="品牌色彩体系中的识别色与中性色" caption="识别色只有品牌白、品牌黑与品牌蓝三支，每支色标同时给出 RGB、CMYK 与 HEX 三组数值，制作时按数值取色。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/08-color-palette.jpg`} alt="色彩运用比例规范，展示识别色、辅助色与特殊色的使用关系" caption="比例条给出识别色、辅助色与特殊色的面积区间，右侧逐条说明各自适用于什么场景、哪些情况不能用。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/09-type-cn.jpg`} alt="中文字体分级规范" caption="同一页列出首选标题字体与首选正文字体，各自标出字体与字重，右侧是该字号下的中文、数字与符号示例。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/10-type-usage.jpg`} alt="品牌字体运用规范，在版面中标出副标题、正文与说明文字各自的位置和字号" caption="字体运用规范把副标题、正文与说明文字分三级标出，每一级对应规范中指定的字体与字重。" kind="proposal" width={1600} height={900} />
      </div>
      <div class="workspace-notes">
        <div><b>颜色分层</b><p>品牌白、黑、蓝各有 RGB、CMYK 与 HEX 色值。辅助色和特殊色按场景使用，面积不超过主色。</p></div>
        <div><b>占比与禁用</b><p>识别色用量为<strong>白色至少 50%、黑色至少 30%、蓝色最多 10%</strong>。纯色背景不使用透明度，也不使用规范外的颜色。</p></div>
        <div><b>字体分级</b><p>中文统一思源黑体（标题 Light/Medium，正文 Light/Regular），数字与英文另配专用字体。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="crossmedia"
      label="06 / 跨媒介扩展"
      title="在不同物料提案里检查规则是否够用"
      intro="把规则套进框架海报、社媒封面和实体物料效果图，检查比例、裁切和底面变化时，标识与信息怎样排。"
    >
      <div class="workspace-stack">
        <article class="workspace">
          <header class="workspace__header">
            <span>01 / 媒介 · 投放框架</span>
            <div><h3>按投放框架安排图片与信息</h3><p>写字楼框架为 1.5 × 2.4 米，电梯框架为 534 × 734 毫米。两个尺寸都提供带信息区与全幅两种模板，按是否需要地址与时间选用。</p></div>
          </header>
          <MediaStage src={`${media}/final/11-media-framing.jpg`} alt="媒体框架海报提案，分别展示写字楼与电梯框架中的带信息区模板和全幅模板" caption="写字楼框架与电梯框架各给出带信息区和全幅两种排法，尺寸直接标在标题上。" kind="proposal" width={1600} height={900} />
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>02 / 社媒 · 模板规则</span>
            <div><h3>更换封面画面时，核对标识和裁切位置</h3><p>公众号主推封面（383 × 900）用竖排镂空标识，次推封面（900 × 900）不加文字。视频号封面（1080 × 1920）标出上下裁切区，固定标识、标语与主体位置。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/final/12-social-templates.jpg`} alt="微信公众号主推与次推封面的模板规范" caption="主推封面固定渐变与竖排镂空标识，次推封面只保留基础元素，不添加文字。" kind="proposal" width={1600} height={900} />
            <MediaStage src={`${media}/final/13-social-cover.jpg`} alt="视频号竖版封面提案，左侧标出裁切、标识和文字区域，右侧展示封面示例" caption="封面按上下裁切区域标出标识、标语与内容主体各自的位置和字号，右侧是画面放进去之后的效果。" kind="proposal" width={1600} height={900} />
          </div>
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>03 / 物料 · 实体触点</span>
            <div><h3>用效果图准备后续打样核对</h3><p>工作证效果图检查小尺寸下如何排人员信息，黑白礼品袋检查标识位置，圆形与方形停机垫检查中心定位图形。实物尺寸和材质留待打样。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/final/15-material-bag.jpg`} alt="黑、白两种底色的礼品袋提案效果图" caption="礼品袋有黑白两个版本，按需求和成本选用，标识与标语的位置在两个版本里保持一致。" kind="proposal" width={1600} height={900} />
            <MediaStage src={`${media}/final/16-material-pad.jpg`} alt="圆形与方形停机垫提案效果图，底面排列标识和定位图形" caption="停机垫给出标准、高亮与便携折叠三种排法，中心定位图形不变，底面形状与网格样式不同。" kind="proposal" width={1600} height={900} />
          </div>
        </article>
      </div>
    </CaseSection>

    <CaseSection
      id="ai-collaboration"
      label="07 / AI 协作"
      title="AI 协助探索画面，我负责选定规则"
      intro="AI 协助生成素材、试验动效和整理文档。我制定视觉规则、筛选可用画面，再把选定方案做成规范与模板。"
      tone="panel"
    >
      <div class="boundary-grid">
        <article class="boundary-card"><h3>工具怎样参与</h3><p>不同工具分别承担概念素材、动态试验和规范排版。</p><ul><li>LibLibAI 与可灵用来尝试概念和场景素材。</li><li>Seedance 把静态品牌素材做成动态画面。</li><li>我用 Figma 排规范页、模板与物料提案。</li></ul></article>
        <article class="boundary-card"><h3>我负责的判断</h3><p>生成画面按印刷和社媒使用要求筛选，再决定是否纳入提案。</p><ul><li>确定四种组合的构成和各场景的选用关系。</li><li>把颜色分成识别色、辅助色与特殊色，定出各自的占比与禁用情形。</li><li>选择模板和物料的呈现方式。</li><li>核对生成素材里的标识和颜色是否符合规范，不符合的先按品牌色和规则调整，再决定是否采用。</li></ul></article>
      </div>
      <MediaStage
        src={`${media}/seedance-clip.mp4`}
        poster={`${media}/final/video-cover.jpg`}
        alt="由竖版社交媒体封面生成的动态化视频示例"
        caption="以竖版社交媒体封面为素材生成的动态试验，保留作过程示例。"
        kind="proposal"
        label="过程示例"
        video
        width={1600}
        height={900}
      />
    </CaseSection>

    <CaseSection
      id="boundary"
      label="08 / 交付与边界"
      title="把后续制作需要的规则交代清楚"
      intro="交付品牌规范、六个子系统的模板与效果图。新物料需要通过打样检查尺寸与颜色在不同材质上的还原。"
    >
      <div class="value-grid">
        <article class="value-card"><span>已交付</span><h3>品牌规范与 6 个子系统</h3><p>标识、色彩和字体规则供查用，媒介、社媒与物料模板给出具体排法。</p></article>
        <article class="value-card"><span>可继续</span><h3>按规则准备下一批物料</h3><p>下一批物料可以从模板替换内容，再按最小尺寸、留白和色值检查后交给供应商打样。</p></article>
        <article class="value-card"><span>待确认</span><h3>打样、投放与真实使用</h3><p>新规范与物料仍为提案。尺寸、材质色差和投放表现留待后续核对。</p></article>
      </div>
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/01-brand-cover.jpg`} alt="品牌视觉规范册封面，黑色底上排列标识、中文标题与英文标题" caption="规范册封面。规范分基础部分与应用部分，标识、色彩、字体和辅助图形属于基础部分，投放、社媒与物料属于应用部分。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/02-manual-toc.jpg`} alt="规范册中的基础部分章节页" caption="“基础部分”章节页，后面依次是标识、色彩与字体各章。" kind="proposal" width={1600} height={900} />
      </div>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">继续看看其他作品</h2>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
      </div>
    </section>
  </main>
</SiteLayout>

---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/brand-system/media';
const facts = [
  { label: '角色', value: '品牌诊断、VI 系统、模板与物料规则设计' },
  { label: '输入', value: '已投产的展会与印刷物料、业务方向、视觉需求清单' },
  { label: '贡献', value: '建立四种标识组合和使用场景矩阵，补齐色彩、字体与跨媒介规则' },
  { label: '输出', value: '24 页品牌规范，外加 6 个子系统的模板和物料设计' },
  { label: '阶段', value: '旧物料已投产；新规范、模板与物料方案均为提案' },
];

const tocSections = [
  { id: 'result', label: '00 / 先看结果' },
  { id: 'origin', label: '01 / 项目源头' },
  { id: 'problem', label: '02 / 问题重定义' },
  { id: 'direction', label: '03 / 关键判断' },
  { id: 'language', label: '04 / 视觉语言' },
  { id: 'crossmedia', label: '05 / 跨媒介扩展' },
  { id: 'ai-collaboration', label: '06 / AI 协作' },
  { id: 'boundary', label: '07 / 交付与边界' },
];
---

<SiteLayout
  title="新禾智飞品牌系统提案｜谢擎宇"
  description="从真实投产触点出发，为一家低空科技企业整理标识、色彩、字体与物料模板规则。"
  current="work"
>
  <main class="case-page" id="main" tabindex="-1">
    <CaseHero
      eyebrow="提案案例 · 品牌与视觉系统"
      title="新禾智飞品牌系统提案"
      summary="一家低空科技企业的展会和印刷物料由不同供应商分批制作，放在一起却很难看出来自同一个品牌。我从旧物料中梳理问题，设计了一套标识、颜色、字体和模板规范，让后续制作有共同的依据。"
      facts={facts}
    />

    <div class="site-container case-cover">
      <MediaStage
        src={`${media}/final/05-identity-combinations.jpg`}
        alt="新禾智飞四种标识组合的规范页面"
        caption="四种标识组合与适用语境。制作人员可以先查场景，再选用对应组合。"
        kind="proposal"
        width={1600}
        height={900}
        priority
      />
    </div>

    <CaseToc title="新禾智飞品牌系统提案" sections={tocSections} />

    <CaseSection
      id="result"
      label="00 / 先看结果"
      title="一张工作证怎样用到四组规则"
      intro="以工作证为例，制作人员先判断使用场景，再选择标识组合、套用版式，最后核对尺寸与印刷规格。下面展示这套规范怎样一起使用。"
      tone="stone"
    >
      <div class="evidence-key" aria-label="工作证规范使用说明">
        <div><b>01　查场景</b><p>先在场景矩阵找到展会和线下活动对应的使用语境。</p></div>
        <div><b>02　选标识</b><p>根据版面方向、中英文信息和可用空间选择现成组合。</p></div>
        <div><b>03　套版式</b><p>把姓名、职务和品牌识别放进工作证模板的固定层级。</p></div>
        <div><b>04　核规格</b><p>检查标识最小尺寸、留白、色值和印刷条件，再交给制作。</p></div>
      </div>
      <MediaStage
        src={`${media}/final/14-material-badge.jpg`}
        alt="工作证提案效果图，展示小尺寸物料中的标识、姓名与信息层级"
        caption="工作证提案效果图，标识、姓名与职务在小尺寸版面中保持清晰的层级。"
        kind="proposal"
        width={1600}
        height={900}
      />
    </CaseSection>

    <CaseSection
      id="origin"
      label="01 / 项目源头"
      title="旧物料完成了传播，却没有形成共同识别"
      intro="展会海报、灯箱、展位画面和产品截图墙来自真实投产触点。把它们放在一起，标识、色彩与信息层级缺少稳定关系。"
    >
      <div class="case-copy">
        <p>这套规范从已有的展会与印刷物料开始。对照业务方向和制作需求，我先看哪些信息反复出现，哪些视觉选择每次都要重新决定。</p>
        <p>每批物料独立委托和设计，制作人员会重复决定标识、字体与版式。新系统需要把这些选择写成不同供应商都能查到的规则。</p>
      </div>
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-drone-poster-observed.jpg`}
          alt="已投产的旧品牌海报，画面含无人机遥感网与低空治理文案"
          caption="旧海报使用渐变底、大标语，并与产品截图混排。"
          kind="observed"
          width={1800}
          height={2310}
        />
        <MediaStage
          src={`${media}/public/legacy-product-wall-observed.jpg`}
          alt="旧横版展板的主营业务截图墙"
          caption="业务介绍以产品截图为主，为品牌层的统一表达留下了整理空间。"
          kind="observed"
          width={1800}
          height={673}
        />
      </div>
    </CaseSection>

    <CaseSection
      id="problem"
      label="02 / 问题重定义"
      title="后续制作要先回答三个具体问题"
      intro="制作一张新物料时，先要知道该用哪种标识，再安排正文与图片的位置。如果这些选择每次都重新开始，换一家供应商就容易得到另一套做法。我据此把规范分成标识选择、信息层级和版式模板，供后续制作查用。"
      tone="panel"
    >
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-intro-text-observed.jpg`}
          alt="旧企业介绍展板的口号与密集文字段（公司名已模糊处理）"
          caption="口号承担识别职能，正文以文字墙铺满版面。"
          kind="observed"
          width={1800}
          height={825}
        />
        <MediaStage
          src={`${media}/public/legacy-stats-band-observed.jpg`}
          alt="旧展板中的数字堆叠带，包含 10+、1000+、200+ 等资质数字"
          caption="数字与资质堆叠代替品牌表达。"
          kind="observed"
          width={1800}
          height={433}
        />
      </div>
      <div class="case-copy">
        <p>政府项目、展会与产品传播需要突出不同内容，版面也有横竖之分。我希望制作人员可以按场景选到合适的组合，同时沿用共同的颜色、字体与尺寸规则，调整内容时仍能看出属于同一个品牌。</p>
      </div>
    </CaseSection>

    <CaseSection
      id="direction"
      label="03 / 关键判断"
      title="四种标识组合对应不同使用语境"
      intro="一套固定组合很难适应所有版面，组合过多又会增加选择负担。我将中英文、横竖版以及品牌与产品的使用需要整理成四种标识组合，再用场景矩阵说明各自适合放在哪里。"
    >
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/04-identity-rationale.jpg`} alt="品牌标识释义页" caption="先定义标识的含义与结构，再谈组合。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/06-identity-construction.jpg`} alt="标识组合与使用场景矩阵" caption="场景矩阵把「该用哪一个」变成可查规则。" kind="proposal" width={1600} height={900} />
      </div>
      <div class="workspace-notes">
        <div><b>为什么是四种</b><p>覆盖中英文、横竖版与品牌、产品语境，同时保持可管理的选择数量。</p></div>
        <div><b>场景矩阵</b><p>把「该用哪一个」从个人经验变成可查规则。</p></div>
        <div><b>保持一致</b><p>最小尺寸与使用边界，让成批生产中的标识保持稳定。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="language"
      label="04 / 视觉语言"
      title="颜色和字体继续回答怎样保持一致"
      intro="选好标识以后，颜色和字体也需要一致。我按使用目的规定色值、字号与间距，制作人员可以直接查用，减少每次凭印象调整。"
      tone="stone"
    >
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/07-color-system.jpg`} alt="品牌色彩体系中的识别色与中性色" caption="色彩按用途分层定义，方便在不同物料中调用。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/08-color-palette.jpg`} alt="辅助色与特殊色的色值规范" caption="辅助色与特殊色附带适用条件，扩展时有据可依。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/09-type-cn.jpg`} alt="中文字体层级规范" caption="中文字体分级，明确标题与正文层级。" kind="proposal" width={1600} height={900} />
      </div>
      <div class="workspace-notes">
        <div><b>色彩三级</b><p>识别色、辅助色、特殊色各管一层，附占比与禁用组合。</p></div>
        <div><b>字体层级</b><p>中文思源黑体、英文专属字体，层级按用途锁定。</p></div>
        <div><b>制作输入</b><p>色值、字号与间距可以直接进入设计文件，生产前仍需按材质核对。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="crossmedia"
      label="05 / 跨媒介扩展"
      title="同一套规则进入投放、社媒和实体物料"
      intro="规范页能讲清规则，具体物料则能检查这些规则是否够用。我把它们放进投放画面、社媒封面和实体物料，逐项考虑版面变窄、文字变多或材质变化时，标识与内容怎样安排。"
    >
      <div class="workspace-stack">
        <article class="workspace">
          <header class="workspace__header">
            <span>01 / 媒介 · 投放框架</span>
            <div><h3>品牌画面先适配投放框架，再谈创意</h3><p>写字楼、电梯与户外框架各有比例和安全区，模板化让同一规则覆盖不同点位。</p></div>
          </header>
          <MediaStage src={`${media}/final/11-media-framing.jpg`} alt="媒体投放框架的版式适配规范" caption="同一视觉规则适配多种投放框架。" kind="proposal" width={1600} height={900} />
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>02 / 社媒 · 模板规则</span>
            <div><h3>社媒模板先从结构规范开始</h3><p>封面与版式模板先明确内容位置和品牌识别，为后续视觉深化提供清楚的版式基础。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/final/12-social-templates.jpg`} alt="社交媒体模板的结构规范稿" caption="先固定内容位置、识别区域与裁切安全区。" kind="proposal" width={1600} height={900} />
            <MediaStage src={`${media}/final/13-social-cover.jpg`} alt="社交媒体封面示例" caption="封面示例验证模板方向。" kind="proposal" width={1600} height={900} />
          </div>
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>03 / 物料 · 实体触点</span>
            <div><h3>把规则写进实体物料方案</h3><p>工作证、礼品袋与停机垫分别覆盖小尺寸信息、大面积底色和行业场景，供后续打样时核对。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/final/15-material-bag.jpg`} alt="礼品袋物料提案效果图" caption="礼品袋提案用于检查大面积底色上的标识规则。" kind="proposal" width={1600} height={900} />
            <MediaStage src={`${media}/final/16-material-pad.jpg`} alt="停机垫物料提案效果图" caption="停机垫提案用于检查行业场景中的识别方式。" kind="proposal" width={1600} height={900} />
          </div>
        </article>
      </div>
    </CaseSection>

    <CaseSection
      id="ai-collaboration"
      label="06 / AI 协作"
      title="生成工具扩大探索范围，我负责收住规则"
      intro="概念发散和素材动态化由生成工具协助，标识结构、场景矩阵、色彩层级与模板取舍由我完成。"
      tone="panel"
    >
      <div class="boundary-grid">
        <article class="boundary-card"><h3>工具与分工</h3><p>生成工具负责扩大探索范围，设计师负责筛选和落地。</p><ul><li>LibLibAI 与可灵用于概念与场景素材发散。</li><li>Seedance 用于静态品牌素材动态化验证。</li><li>Figma 用于规范、模板与物料落地。</li><li>生成结果按品牌色与规范收敛后再评估。</li></ul></article>
        <article class="boundary-card"><h3>设计判断</h3><p>设计师保留品牌系统中的关键选择。</p><ul><li>标识结构、组合数量与场景矩阵。</li><li>色彩层级与占比规则。</li><li>模板取舍与物料的最终形态。</li><li>检查生成素材是否符合标识和色彩规范。</li></ul></article>
      </div>
      <MediaStage
        src={`${media}/seedance-clip.mp4`}
        poster={`${media}/final/video-cover.jpg`}
        alt="由竖版社交媒体封面生成的动态化视频示例"
        caption="以竖版社交媒体封面为原素材，验证静态画面的动态化方向。"
        kind="proposal"
        label="过程示例"
        video
        width={1600}
        height={900}
      />
    </CaseSection>

    <CaseSection
      id="boundary"
      label="07 / 交付与边界"
      title="把后续制作需要的规则交代清楚"
      intro="这份提案完成了 24 页规范，覆盖标识、色彩、字体、媒介、社媒与物料。制作人员可以按场景找到组合，再查对应的版式与规格。"
    >
      <div class="value-grid">
        <article class="value-card"><span>已交付</span><h3>24 页规范与 6 个子系统</h3><p>规范页解释怎么选、怎么用，模板与效果图展示它们放在一起的样子。</p></article>
        <article class="value-card"><span>可继续</span><h3>从场景矩阵开始制作</h3><p>制作人员可以先选语境和标识组合，再调用颜色、字体、版式与规格。</p></article>
        <article class="value-card"><span>待确认</span><h3>打样、投放与真实使用</h3><p>新方案处于提案阶段，下一步需要与供应商打样，核对不同材质上的颜色还原和实际尺寸。</p></article>
      </div>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">让下一批物料从规则开始</h2>
      <p>后续新增物料时，可以沿用这套选择方法，从已有组合和模板开始，再根据具体内容调整。</p>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
        <a href="mailto:second988@qq.com">邮件联系</a>
      </div>
    </section>
  </main>
</SiteLayout>

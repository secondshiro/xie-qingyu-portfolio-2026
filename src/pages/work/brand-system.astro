---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import DesignEvidence from '../../components/DesignEvidence.astro';
import EvidenceDetail from '../../components/EvidenceDetail.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/brand-system/media';
const facts = [
  { label: '角色', value: '梳理旧物料问题，设计品牌视觉规范与制作模板' },
  { label: '输出', value: '24 页品牌规范，外加 6 个子系统的模板和物料设计' },
  { label: '阶段', value: '旧物料已投产；新规范、模板与物料方案均为提案' },
];

const tocSections = [
  { id: 'result', label: '00 / 先看结果' },
  { id: 'origin', label: '01 / 项目源头' },
  { id: 'direction', label: '02 / 标识与文字' },
  { id: 'crossmedia', label: '03 / 封面与物料' },
];
---

<SiteLayout
  title="新禾智飞品牌系统提案｜谢擎宇"
  description="从已投产的展会与印刷物料出发，设计标识选用规则和制作模板，完成 24 页规范与六个子系统提案。"
  current="work"
>
  <main class="case-page" id="main" tabindex="-1">
    <CaseHero
      eyebrow="提案案例 · 品牌与视觉系统"
      title="新禾智飞品牌系统提案"
      summary="同一家低空科技企业的物料由不同供应商分批制作，标识与版式各有做法。我从海报和展板出发，把常用版式与选用条件整理为模板，供后续制作时查用。"
      facts={facts}
    />

    <CaseToc title="新禾智飞品牌系统提案" sections={tocSections} />

    <CaseSection id="result" label="00 / 先看结果" title="海报要带多少信息，决定了怎样留白" intro="框架海报既要呈现品牌画面，也可能需要地址、时间等具体信息。我在规范中安排两种模板，信息较多时留出独立区域，主要展示画面时采用全幅构图。" tone="stone">
      <div class="evidence-grid">
        <EvidenceDetail src={`${media}/figma/poster-layouts.png`} width={1920} height={1080} region={[542,274,546,340]} label="留白模板 · 原稿局部" alt="横版海报在主画面下方留出白色信息区" caption="独立信息区放在下方，主画面需要让出一部分高度。" />
        <EvidenceDetail src={`${media}/figma/poster-layouts.png`} width={1920} height={1080} region={[542,630,546,340]} label="全幅模板 · 原稿局部" alt="同一画面的全幅海报，文字与标识叠放在图像上" caption="画面延伸到底部，文字集中在图像下沿，信息量需要控制。" />
      </div>
      <details class="case-supplement"><summary>查看完整海报规范</summary>
      <DesignEvidence id="brand-posters" title="海报模板与使用规则" src={`${media}/figma/poster-layouts.png`} width={1920} height={1080} label="品牌系统提案" alt="完整海报规范，包含留白与全幅两组模板和选用条件" caption="原规范要求带地址、时间等信息时采用留白模板；示意图展示的是版式安排。" />
      </details>
    </CaseSection>

    <CaseSection id="origin" label="01 / 项目起点" title="旧物料每次都重新安排标识和文字" intro="旧海报以大号标语和设备画面介绍业务，横版展板则排满产品截图。我把旧物料与需求清单放在一起核对，保留随内容变化的构图，将标识组合、字体和颜色写成选用规则。">
      <div id="problem">
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-drone-poster-observed.jpg`}
          alt="已投产的旧品牌海报，画面含无人机遥感网与低空治理文案"
          caption="旧海报以蓝色天空和山景为底，大号标语下方展示无人机与设备。"
          kind="observed"
          width={1800}
          height={2310}
        />
        <MediaStage
          src={`${media}/public/legacy-product-wall-observed.jpg`}
          alt="旧横版展板的主营业务截图墙"
          caption="旧横版展板以产品截图介绍业务，标题和截图占据主要版面。"
          kind="observed"
          width={1800}
          height={673}
        />
      </div>
      </div>
    </CaseSection>

    <CaseSection
      id="direction"
      label="02 / 标识与文字"
      title="先查使用场景，再选合适的标识组合"
      intro="一套固定组合很难适应所有版面，组合过多又会增加选择负担。我保留四种标识组合，把中英文和不同版面中的选用依据写进场景矩阵，也就是一张按用途查标识的表。"
    >
      <DesignEvidence id="brand-identity" title="按场景选择标识" src={`${media}/figma/identity-selection.png`} alt="四种标识的场景选用表，区分首选和次选" caption="平面与活动优先使用常用组合；产品侧重图形标识，品牌联合与海外用途另列英文组合。" width={1920} height={1080} label="品牌系统提案" />
      <div class="case-copy"><p>英文组合还分横版与竖版。规范将竖版限定在竖向或方形的品牌联合场景，避免制作时只按空位随意选择组合。</p></div>
      <div id="language" class="case-copy"><h3>颜色和字重也给出明确用法</h3><p>选好标识后，再按下面的比例分配颜色，按标题和正文选择字重。</p></div>
      <div class="evidence-grid">
        <DesignEvidence id="brand-color" title="色彩运用比例" src={`${media}/final/08-color-palette.jpg`} alt="品牌色彩的面积比例与适用条件" caption="色彩规范用面积比例控制主次，品牌蓝只占局部。" width={1600} height={900} label="品牌系统提案" />
        <DesignEvidence id="brand-type" title="中文字体层级" src={`${media}/final/09-type-cn.jpg`} alt="思源黑体在中文标题与正文中的选用规范" caption="标题与正文分别指定字重，英文和数字另用 Urbane。" width={1600} height={900} label="品牌系统提案" />
      </div>
    </CaseSection>

    <CaseSection id="crossmedia" label="03 / 封面与物料" title="换一种媒介，重新安排重要信息" intro="海报解决信息量变化，竖版封面还要考虑画面被裁切的位置。我把标识、文字和内容主体分区，让换图时需要保留的部分一目了然。">
      <div class="brand-cover-detail">
        <EvidenceDetail src={`${media}/figma/vertical-cover.png`} width={1920} height={1080} region={[611,271,409,727]} aspect={9/16} label="封面分区 · 原稿局部" alt="封面规范上下为灰色裁切区域，中间保留标识、标题与内容主体" caption="灰色区域可能被裁掉，标识与标题留在中间。" />
        <div class="case-copy"><h3>先确定保留区，再放标识和标题</h3><p>这份封面规范将上下两端留作裁切区。标识放在保留区上方，标题紧随其后，内容主体占据中下部。换背景时，再检查人物是否避开裁切区、文字能否读清。</p><details class="case-supplement"><summary>查看完整封面规范与示意</summary><DesignEvidence id="brand-cover" title="竖版封面的裁切与信息位置" src={`${media}/figma/vertical-cover.png`} width={1920} height={1080} label="品牌系统提案" alt="完整封面规范与示意，注明裁切区、字号和间距" caption="左侧为分区与尺寸要求，右侧为采用这份规范的封面示意。" /></details></div>
      </div>
      <DesignEvidence id="brand-badge" title="工作证的信息安排" src={`${media}/figma/staff-badge.png`} width={1920} height={1080} label="物料提案" alt="工作证正面包含照片、姓名和工作人员身份，背面放置资料二维码与编号" caption="工作证正面用于辨认人员，背面提供展会资料入口。" />
      <div class="case-copy"><p>实体物料仍需按材质和实际尺寸打样。</p></div>
      <details class="brand-more"><summary>查看礼品袋与停机垫提案</summary><div class="evidence-grid">
        <MediaStage src={`${media}/final/15-material-bag.jpg`} alt="黑白两种礼品袋提案" caption="礼品袋展示大面积底色上的标识与文字。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/16-material-pad.jpg`} alt="圆形与方形停机垫提案" caption="停机垫将标识和定位图形放到不同形状的底面上。" kind="proposal" width={1600} height={900} />
      </div></details>
      <details id="ai-collaboration" class="case-supplement"><summary>查看 AI 画面探索与动态试验</summary>
      <div id="boundary" class="case-copy"><p>LibLibAI 与可灵用于探索场景素材，我在 Figma 中整理规范与模板。下面的 Seedance 试验以竖版封面为输入，查看静态画面转为动态后的表现。</p></div>
      <MediaStage
        src={`${media}/seedance-clip.mp4`}
        poster={`${media}/final/video-cover.jpg`}
        alt="由竖版社交媒体封面生成的动态化视频示例"
        caption="以竖版社交媒体封面为素材生成的动态试验，保留作过程示例。"
        kind="proposal"
        label="过程示例"
        video
        width={1214}
        height={1846}
        class="brand-motion"
      />
      </details>
    </CaseSection>

    <section class="site-container case-closing" aria-labelledby="closing-title">
      <h2 id="closing-title">继续看看其他作品</h2>
      <div class="case-closing__links">
        <a href="/#selected-work">返回作品索引</a>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
.brand-cover-detail { display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); align-items: start; gap: 2rem; }
@media (max-width: 45rem) { .brand-cover-detail { grid-template-columns: 1fr; } }
.brand-more summary { min-height: 44px; cursor: pointer; color: var(--color-accent); font-size: 14px; }
.brand-more .evidence-grid { margin-top: 1.5rem; }
:global(.brand-motion .media-stage__frame) { display: grid; place-items: center; }
:global(.brand-motion video) { display: block; width: min(100%, 25rem); height: auto; max-height: 38rem; object-fit: contain; }
</style>

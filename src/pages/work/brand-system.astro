---
import CaseHero from '../../components/CaseHero.astro';
import CaseSection from '../../components/CaseSection.astro';
import CaseToc from '../../components/CaseToc.astro';
import MediaStage from '../../components/MediaStage.astro';
import BrandAuxiliary from '../../components/BrandAuxiliary.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/case-study.css';

const media = '/projects/brand-system/media';
const facts = [
  { label: '角色', value: '梳理旧物料问题，设计品牌视觉规范与制作模板' },
  { label: '输入', value: '已投产的展会与印刷物料、业务方向、视觉需求清单' },
  { label: '贡献', value: '确定四种标识组合与选用表，整理颜色、字体和各类物料的制作规则' },
  { label: '输出', value: '品牌规范，外加 6 个子系统的模板和物料设计' },
  { label: '阶段', value: '旧物料已投产；新规范、模板与物料方案均为提案' },
];

const tocSections = [
  { id: 'result', label: '00 / 先看结果' },
  { id: 'origin', label: '01 / 项目源头' },
  { id: 'problem', label: '02 / 问题重定义' },
  { id: 'direction', label: '03 / 关键判断' },
  { id: 'auxiliary', label: '04 / 辅助图形' },
  { id: 'language', label: '05 / 视觉语言' },
  { id: 'crossmedia', label: '06 / 跨媒介扩展' },
  { id: 'ai-collaboration', label: '07 / AI 协作' },
  { id: 'boundary', label: '08 / 交付与边界' },
];
---

<SiteLayout
  title="新禾智飞品牌系统提案｜谢擎宇"
  description="从已投产的展会与印刷物料出发，设计四种标识组合的选用表、颜色与字体分级和物料模板，形成一套品牌规范与六个子系统提案。"
  current="work"
>
  <main class="case-page" id="main" tabindex="-1">
    <CaseHero
      eyebrow="提案案例 · 品牌与视觉系统"
      title="新禾智飞品牌系统提案"
      summary="一家低空科技企业的海报、展板和印刷物料由不同供应商分批制作，标识、字号和颜色各有做法。我把四种标识组合整理成一张按使用场景查的选用表，给颜色和字体定出层级与使用占比，再为投放、社媒和实体物料准备可以直接套用的模板。旧物料已投产，新规范与模板仍处于提案阶段。"
      facts={facts}
    />

    <div class="site-container case-cover">
      <MediaStage
        src={`${media}/final/05-identity-combinations.jpg`}
        alt="英文标识横版与竖版组合的比例、留白和最小尺寸规范"
        caption="比例与留白按标识高度 X 的倍数标注，最小尺寸区分印刷与屏幕，横版和竖版各有下限。"
        kind="proposal"
        width={1600}
        height={900}
        priority
      />
    </div>

    <CaseToc title="新禾智飞品牌系统提案" sections={tocSections} />

    <CaseSection
      id="result"
      label="00 / 先看结果"
      title="一张工作证怎样用到四组规则"
      intro="制作新物料时，制作人员要先决定用哪种标识组合、姓名放在版面什么位置，再核对交给供应商的规格。以工作证提案为例，这四处判断分别对应规范里的场景分类、标识组合、版式模板和制作规格。"
      tone="stone"
    >
      <div class="evidence-key" aria-label="工作证规范使用说明">
        <div><b>01　查场景</b><p>在选用表里按场景找到这类物料对应的行。</p></div>
        <div><b>02　选标识</b><p>按版面方向、中英文信息和可用空间，在首选与次选里挑一组现成组合。</p></div>
        <div><b>03　套版式</b><p>用工作证模板安排照片、姓名与工作人员身份，标识位置不动。</p></div>
        <div><b>04　核规格</b><p>核对标识最小尺寸、留白、色值与印刷条件，再交给供应商。</p></div>
      </div>
      <MediaStage
        src={`${media}/final/14-material-badge.jpg`}
        alt="工作证提案效果图，正面排列照片、姓名、工作人员身份与标识，背面放置二维码"
        caption="正面安排照片、姓名与人员身份，背面放展会资料二维码与证件编号；实际尺寸仍需打样核对。"
        kind="proposal"
        width={1600}
        height={900}
      />
    </CaseSection>

    <CaseSection
      id="origin"
      label="01 / 项目源头"
      title="新一批物料，又要重新决定标识和版式"
      intro="旧展会和印刷物料已经投产，由不同供应商分批制作，标识、颜色和版式各有做法。面对新一批物料，我要判断哪些选择可以共同沿用，哪些本来就该随内容变化。"
    >
      <div class="case-copy">
        <p>海报要介绍业务，展板要呈现产品，内容与比例本来就可以不同。但对照旧物料可以看到，标识怎么出现、正文用什么字体、标题和说明文字差多少，每次都在重新决定。</p>
        <p>这些依据如果只留在某一版设计稿里，下一个人换一批内容或换一家供应商时还要再判断一遍。我把可以沿用的部分写成规范，让后续制作先查规则再动手。</p>
      </div>
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-drone-poster-observed.jpg`}
          alt="已投产的旧品牌海报，画面含无人机遥感网与低空治理文案"
          caption="旧海报用两行大标语加设备实拍介绍业务，整个版面留给一句业务说明，没有第二层信息。"
          kind="observed"
          width={1800}
          height={2310}
        />
        <MediaStage
          src={`${media}/public/legacy-product-wall-observed.jpg`}
          alt="旧横版展板的主营业务截图墙"
          caption="同一块展板并排三个业务板块，每个板块下再挂多张产品截图，标题层级与截图尺寸各不相同。"
          kind="observed"
          width={1800}
          height={673}
        />
      </div>
    </CaseSection>

    <CaseSection
      id="problem"
      label="02 / 问题重定义"
      title="把每次制作要做的选择写成规则"
      intro="制作人员拿到新内容后，要决定用哪种标识、标题和正文怎样区分、图片和信息各放在哪里。我把这几类反复出现的判断整理成选用表和版式模板，让规范能直接回答制作时的问题。"
      tone="panel"
    >
      <div class="evidence-grid">
        <MediaStage
          src={`${media}/public/legacy-intro-text-observed.jpg`}
          alt="旧企业介绍展板，蓝底上排列多段白色正文，顶部标题已模糊处理"
          caption="四段正文用相近字号连续排在蓝色底上，标题与正文之间没有明显的字号差。"
          kind="observed"
          width={1800}
          height={825}
        />
        <MediaStage
          src={`${media}/public/legacy-stats-band-observed.jpg`}
          alt="旧展板中的数字堆叠带，包含 10+、1000+、200+ 等资质数字"
          caption="八个资质数字并排、字号一致，单位说明小一号，整条带子没有层级区分。"
          kind="observed"
          width={1800}
          height={433}
        />
      </div>
      <div class="case-copy">
        <p>旧画面里的企业介绍和资质信息仍然要用。问题在于它们挤在同一层级，企业介绍用相近字号排了四段正文，资质带把八个数字并排放成一样大。新规范把标题、正文和说明信息分开，各自指定字体、字重与间距；数字和英文另用一套字体。制作人员换内容时，按版面找到对应层级套进去即可。</p>
      </div>
    </CaseSection>

    <CaseSection
      id="direction"
      label="03 / 关键判断"
      title="先查使用场景，再选合适的标识组合"
      intro="一套组合很难适应所有版面，给多了又会增加选择负担。我保留四种标识组合，把选用依据写成一张标识选用表。表的行分两层，场景层是标识出现的场合，即线上线下的平面物料、活动现场、网页与应用界面、面向海外的物料；应用层说明标识落在什么物件上、与谁一起出现，即精品产品、无人机产品本体、与其他品牌联合的物料。横栏是四种组合，交叉位置标出首选和次选。"
    >
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/04-identity-rationale.jpg`} alt="品牌标识释义页，标出左右对称轴与上下对称轴" caption="标识由字母 X 与 H 组合，释义页标出左右与上下两条对称轴，四种组合都以这个基础形为准。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/06-identity-construction.jpg`} alt="标识选用表，按场景列出首选和次选组合" caption="每一类场景标出首选和次选，制作人员先查场景所在的行，再横向找到对应的组合。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/03-context-scenes.jpg`} alt="常用组合标识运用示意，把标识放进展位画面、横版海报与竖版画面" caption="运用示意图把同一组标识放进几种版面，标识位置随版面方向变化。" kind="proposal" width={1600} height={900} />
      </div>
      <div class="workspace-notes">
        <div><b>为什么是四种</b><p>中英文、品牌与产品各需要一组，四种能覆盖常见版面，也不会让选择变多。</p></div>
        <div><b>怎样选用</b><p>先按场景查到首选和次选，再根据版面方向与可用空间定下来。</p></div>
        <div><b>制作前核对</b><p>按最小尺寸和留白要求检查，避免标识放进版面后过小，或者和文字挤在一起。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="auxiliary"
      label="04 / 辅助图形"
      title="把标识折角延伸成辅助图形"
      intro="在原有规范之外，我补了一组“双折面”辅助图形提案。灵感来自标识里的斜向笔画和内折角，这些结构本身带有方向感，与品牌的飞行主题同向。我把两个折面相向排列，用在海报和封面的边缘。"
    >
      <BrandAuxiliary />
    </CaseSection>

    <CaseSection
      id="language"
      label="05 / 视觉语言"
      title="选好标识，再查颜色和字体"
      intro="标识和辅助图形定下来之后，颜色与字体同样要有依据。我按用途把颜色分层、把字体分级，并把色值、字号与间距写进规范，制作人员查表取用，不必凭印象调。"
      tone="stone"
    >
      <div class="evidence-grid">
        <MediaStage src={`${media}/final/07-color-system.jpg`} alt="品牌色彩体系中的识别色与中性色" caption="识别色只有品牌白、品牌黑与品牌蓝三支，每支色标同时给出 RGB、CMYK 与 HEX 三组数值，制作时按数值取色。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/08-color-palette.jpg`} alt="色彩运用比例规范，展示识别色、辅助色与特殊色的使用关系" caption="比例条给出识别色、辅助色与特殊色的面积区间，右侧逐条说明各自适用于什么场景、哪些情况不能用。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/09-type-cn.jpg`} alt="中文字体分级规范" caption="同一页列出首选标题字体与首选正文字体，各自标出字体与字重，右侧是该字号下的中文、数字与符号示例。" kind="proposal" width={1600} height={900} />
        <MediaStage src={`${media}/final/10-type-usage.jpg`} alt="品牌字体运用规范，在版面中标出副标题、正文与说明文字各自的位置和字号" caption="字体运用规范把副标题、正文与说明文字分三级标出，每一级对应规范中指定的字体与字重。" kind="proposal" width={1600} height={900} />
      </div>
      <div class="workspace-notes">
        <div><b>颜色分层</b><p>识别色只有品牌白、品牌黑与品牌蓝，每支色标给出 RGB、CMYK 与 HEX 三组数值，可以直接取用；辅助色和特殊色按场景点使用，面积不超过主色。</p></div>
        <div><b>占比与禁用</b><p>品牌白占一半以上、品牌黑三成以上、品牌蓝一成以内；纯色背景不使用透明度，也不使用规范外的颜色。</p></div>
        <div><b>字体分级</b><p>中文用思源黑体，标题取 Light 或 Medium，正文取 Light 或 Regular，数字与英文另用一套字体。</p></div>
      </div>
    </CaseSection>

    <CaseSection
      id="crossmedia"
      label="06 / 跨媒介扩展"
      title="在不同物料提案里检查规则是否够用"
      intro="规范页只写规则，具体版面要检查是否放得下。我把同一套规则用到写字楼与电梯框架海报、公众号与视频号封面，再做礼品袋、停机垫这类实体物料的效果图，看比例和信息量变了之后标识与内容怎么排。"
    >
      <div class="workspace-stack">
        <article class="workspace">
          <header class="workspace__header">
            <span>01 / 媒介 · 投放框架</span>
            <div><h3>按投放框架安排图片与信息</h3><p>写字楼框架是 1.5×2.4 米，电梯框架是 534×734 毫米，两者比例不同。提案各留两种排法，要放地址和时间信息时用带信息区的版本，要整幅画面时用全幅版本，制作人员按内容选。</p></div>
          </header>
          <MediaStage src={`${media}/final/11-media-framing.jpg`} alt="媒体框架海报提案，分别展示写字楼与电梯框架中的带信息区模板和全幅模板" caption="写字楼框架与电梯框架各给出带信息区和全幅两种排法，尺寸直接标在标题上。" kind="proposal" width={1600} height={900} />
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>02 / 社媒 · 模板规则</span>
            <div><h3>更换封面画面时，核对标识和裁切位置</h3><p>公众号主推封面是 383×900，固定深灰渐变与白色辅助图形，标识用镂空字竖排；次推封面是 900×900，规定不加任何文字。视频号竖版封面为 1080×1920，标出上下裁切区域，把标识、标语和内容主体各自的位置与字号固定下来。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/final/12-social-templates.jpg`} alt="微信公众号主推与次推封面的模板规范" caption="主推封面固定渐变与竖排镂空标识，次推封面只保留基础元素，不添加文字。" kind="proposal" width={1600} height={900} />
            <MediaStage src={`${media}/final/13-social-cover.jpg`} alt="视频号竖版封面提案，左侧标出裁切、标识和文字区域，右侧展示封面示例" caption="封面按上下裁切区域标出标识、标语与内容主体各自的位置和字号，右侧是画面放进去之后的效果。" kind="proposal" width={1600} height={900} />
          </div>
        </article>

        <article class="workspace">
          <header class="workspace__header">
            <span>03 / 物料 · 实体触点</span>
            <div><h3>用效果图准备后续打样核对</h3><p>工作证检查小尺寸下人员信息怎么排，礼品袋看黑白两种底色上的标识位置，停机垫则检查圆形与方形底面上的中心定位图形。三件都是效果图，材质与实际尺寸仍需打样确认。</p></div>
          </header>
          <div class="evidence-grid">
            <MediaStage src={`${media}/final/15-material-bag.jpg`} alt="黑、白两种底色的礼品袋提案效果图" caption="礼品袋有黑白两个版本，按需求和成本选用，标识与标语的位置在两个版本里保持一致。" kind="proposal" width={1600} height={900} />
            <MediaStage src={`${media}/final/16-material-pad.jpg`} alt="圆形与方形停机垫提案效果图，底面排列标识和定位图形" caption="停机垫给出标准、高亮与便携折叠三种排法，中心定位图形不变，底面形状与网格样式不同。" kind="proposal" width={1600} height={900} />
          </div>
        </article>
      </div>
    </CaseSection>

    <CaseSection
      id="ai-collaboration"
      label="07 / AI 协作"
      title="AI 协助探索画面，我负责选定规则"
      intro="生成工具用来出画面，用不用由我判断。素材生成、动态试验和规范整理分别交给不同工具，我给出规则、筛选结果，再把选定的方案整理成模板。"
      tone="panel"
    >
      <div class="boundary-grid">
        <article class="boundary-card"><h3>工具怎样参与</h3><p>生成、动态与整理分别由不同工具承担。</p><ul><li>LibLibAI 与可灵用来尝试概念和场景素材。</li><li>Seedance 把静态品牌素材做成动态画面。</li><li>我用 Figma 排规范页、模板与物料提案。</li></ul></article>
        <article class="boundary-card"><h3>我负责的判断</h3><p>生成画面能不能进提案，要对照具体使用要求判断。</p><ul><li>确定四种组合的构成和各场景的选用关系。</li><li>把颜色分成识别色、辅助色与特殊色，定出各自的占比与禁用情形。</li><li>选择模板和物料的呈现方式。</li><li>核对生成素材里的标识和颜色是否符合规范，不符合的先按品牌色和规则调整，再决定是否采用。</li></ul></article>
      </div>
      <MediaStage
        src={`${media}/seedance-clip.mp4`}
        poster={`${media}/final/video-cover.jpg`}
        alt="由竖版社交媒体封面生成的动态化视频示例"
        caption="以竖版社交媒体封面为素材生成的动态试验，保留作过程示例。"
        kind="proposal"
        label="过程示例"
        video
        width={1600}
        height={900}
      />
    </CaseSection>

    <CaseSection
      id="boundary"
      label="08 / 交付与边界"
      title="把后续制作需要的规则交代清楚"
      intro="交付物是一套品牌规范与六个子系统的模板和效果图，覆盖标识、色彩、字体、媒介、社媒与物料。下一步是用新物料打样，核对颜色在不同材质上的还原和实际尺寸。"
    >
      <div class="value-grid">
        <article class="value-card"><span>已交付</span><h3>品牌规范与 6 个子系统</h3><p>标识、色彩、字体、媒介、社媒与物料六个部分，说明每类组合与色值在什么场景下使用，模板和效果图给出具体排法。</p></article>
        <article class="value-card"><span>可继续</span><h3>按规则准备下一批物料</h3><p>下一批物料可以从已有模板开始替换内容，再按最小尺寸、留白与色值过一遍，合格后交给供应商。</p></article>
        <article class="value-card"><span>待确认</span><h3>打样、投放与真实使用</h3><p>规范与模板都还没投产，需要先和供应商打样，看颜色在不同材质上的还原和实际尺寸是否符合要求。</p></article>

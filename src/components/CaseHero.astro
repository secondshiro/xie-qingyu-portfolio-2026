---
interface Fact {
  label: string;
  value: string;
}

interface Props {
  title: string;
  summary: string;
  facts: Fact[];
  eyebrow?: string;
}

const { title, summary, facts, eyebrow = '完整案例 · 复杂系统体验' } = Astro.props;
---

<header class="case-hero site-container">
  <div class="case-hero__copy">
    <p class="case-hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="case-hero__summary">{summary}</p>
  </div>
  <dl class="case-hero__facts">
    {facts.map((fact) => (
      <div>
        <dt>{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>
</header>

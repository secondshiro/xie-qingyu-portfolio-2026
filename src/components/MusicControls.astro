---
import '../styles/home-music.css';
---
<div class="retro-camera music-camera"><div class="music-world">
<div class="music" data-music role="group" aria-label="配乐音量" hidden>
  <button class="music__mute" type="button" data-music-mute aria-label="静音" aria-pressed="false" title="静音">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 5 6 9H3v6h3l5 4Z" />
      <g data-music-on><path d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></g>
      <path data-music-off d="m16 9 6 6m0-6-6 6" />
    </svg>
  </button>
  <label class="music__volume"><span class="sr-only">音量</span><input data-music-volume type="range" min="0" max="100" value="25" aria-label="音量"></label>
  <span class="sr-only" data-music-status role="status"></span>
  <audio data-music-audio preload="none" loop></audio>
</div>
</div></div>
